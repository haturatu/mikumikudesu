set(LIBMMD_PROVIDER "AUTO" CACHE STRING "libmmd provider: AUTO, SYSTEM, or BUNDLED")
set_property(CACHE LIBMMD_PROVIDER PROPERTY STRINGS AUTO SYSTEM BUNDLED)
string(TOUPPER "${LIBMMD_PROVIDER}" _libmmd_provider)
if(NOT _libmmd_provider MATCHES "^(AUTO|SYSTEM|BUNDLED)$")
  message(FATAL_ERROR "LIBMMD_PROVIDER must be AUTO, SYSTEM, or BUNDLED")
endif()
set(_libmmd_components core animation physics)
if(DAYO_ENABLE_PHYSICS)
  list(APPEND _libmmd_components bullet)
endif()
set(_libmmd_system FALSE)
if(NOT _libmmd_provider STREQUAL "BUNDLED")
  if(_libmmd_provider STREQUAL "SYSTEM")
    find_package(libmmd 0.3.2 CONFIG REQUIRED COMPONENTS ${_libmmd_components})
  else()
    find_package(libmmd 0.3.2 CONFIG QUIET COMPONENTS ${_libmmd_components})
  endif()
  if(libmmd_FOUND)
    set(_libmmd_system TRUE)
  endif()
endif()
if(_libmmd_system)
  message(STATUS "Using system libmmd ${libmmd_VERSION}")
else()
  message(STATUS "Using bundled libmmd")
  set(LIBMMD_ENABLE_PHYSICS ON CACHE BOOL "Build the libmmd physics API required by the runtime" FORCE)
  set(LIBMMD_ENABLE_BULLET ${DAYO_ENABLE_PHYSICS} CACHE BOOL "Use Bullet acceleration in libmmd" FORCE)
  set(LIBMMD_BUILD_TESTS OFF CACHE BOOL "Build libmmd standalone tests" FORCE)
  set(LIBMMD_FETCH_DEPENDENCIES ${DAYO_FETCH_DEPENDENCIES} CACHE BOOL "Fetch libmmd optional dependencies" FORCE)
  set(LIBMMD_INSTALL OFF CACHE BOOL "Do not install embedded libmmd separately" FORCE)
  add_subdirectory(external/libmmd EXCLUDE_FROM_ALL)
endif()
