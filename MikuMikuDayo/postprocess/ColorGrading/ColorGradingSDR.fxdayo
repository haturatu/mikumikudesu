#include "../../hlsl/resources_PP.hlsli"
#include "../../hlsl/yrz.hlsli"
using namespace Dayo;
using namespace YRZ;

[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
		"category" : "postprocess",
        "controllers": [
			{ "name":"C_LiftH", "controllerName":"(self)", "item":"LiftH", "type":"float", 
				"desc":["","暗部を調整します"]},
			{ "name":"C_LiftS", "controllerName":"(self)", "item":"LiftS", "type":"float" , 
				"desc":["","暗部を調整します"]},
			{ "name":"C_LiftV", "controllerName":"(self)", "item":"LiftV", "type":"float", "slider":{"def":0.5},
				"desc":["","暗部を調整します"]},

			{ "name":"C_GammaH", "controllerName":"(self)", "item":"GammaH", "type":"float" , 
				"desc":["","中間部を調整します"]},
			{ "name":"C_GammaS", "controllerName":"(self)", "item":"GammaS", "type":"float" , 
				"desc":["","中間部を調整します"]},
			{ "name":"C_GammaV", "controllerName":"(self)", "item":"GammaV", "type":"float", "slider":{"def":0.5} , 
				"desc":["","中間部を調整します"]},

			{ "name":"C_GainH", "controllerName":"(self)", "item":"GainH", "type":"float",
				"desc":["","ハイライト部を調整します"] },
			{ "name":"C_GainS", "controllerName":"(self)", "item":"GainS", "type":"float" ,
				"desc":["","ハイライト部を調整します"] },
			{ "name":"C_GainV", "controllerName":"(self)", "item":"GainV", "type":"float", "slider":{"def":0.5},
				"desc":["","ハイライト部を調整します"] },
			
			{ "name":"C_ColTemp", "controllerName":"(self)", "item":"色温度", "type":"float", "slider":{"def":0.5} },
			{ "name":"C_ColorTemperaturePow", "controllerName":"(self)", "item":"温度補正強さ", "type":"float", "slider":{"def":1} },

			{ "name":"C_SatH", "controllerName":"(self)", "item":"PresatH", "type":"float",
				"desc":["","全体的な色相を指定します"] },
			{ "name":"C_SatS", "controllerName":"(self)", "item":"PresatS", "type":"float",
				"desc":["","PresatHで指定した色相の色に近づけます"] },
			{ "name":"C_SatV", "controllerName":"(self)", "item":"PresatV", "type":"float", "slider":{"def":1}, 
				"desc":["","全体的な彩度を指定します"]},

			{ "name":"C_TestMode", "controllerName":"(self)", "item":"比較モード", "type":"float" },
		],
		"textures":[
			{"name":"CLUT", "size":{"absolute":true, "width":1024, "height":32}, "view":"RTV,UAV", "format":"R8G8B8A8_UNORM"}
		],
		"samplers":[
			{"name":"Samp"}
		],
        "passes": [
			{ "name":"Main", "type":"postprocess", "pixelShader":"PS", "vertexShader":"VS", "UAV":[{"name":"CLUT"}], "outputSize":{"base":"DEFAULT_RTSIZE"} },
			{ "name":"CLUT", "type":"postprocess", "pixelShader":"PS", "vertexShader":"VS", "RTV":[{"name":"CLUT"}]}
		]
    }
}
[HLSL]

static float3 LiftColor = HSVtoRGB(float3(C_LiftH, C_LiftS, C_LiftV));
static float3 GammaColor = HSVtoRGB(float3(C_GammaH, C_GammaS, C_GammaV));
static float3 GainColor = HSVtoRGB(float3(C_GainH, C_GainS, C_GainV));
static float ColorTemperature = exp2(C_ColTemp*2-1) * 6500;
static float3 Presaturation = HSVtoRGB(float3(C_SatH, C_SatS, C_SatV));

//テスト用、SB曲線に基づいて各色温度の色合いを計算
//Stefan-Boltzmann's law
double SB(double l, double t)
{
	const double h = 6.62606957E-34;
	const double kb = 1.3806488E-23;
	const double c = 299792458;
	const double L = l * 1e-9;
	return (2 * h * c * c) / (pow(L, 5) * (exp(h * c / (L * kb * t)) - 1));
}

//tケルビンの色(明度1)をXYZで返す
float3 XYZSB(float t)
{
	double3 xyz = 0;
	for (int i=0; i<NUM_CIE1931; i++) {
		double l = MIN_CIE1931 + i*5;
		double v = SB(l, t);
		//double v = D65Illuminant[i].y;
		xyz += CIE1931[i].yzw * v;
	}

	return xyz / xyz.y;
}

//SB曲線からtケルビンの色をRGBで返す
float3 RGBSB(float t)
{
	//色温度6500Kの時を1として補正する
	//※色温度6500Kの完全黒体の色が(1,1,1)になるわけではなく
	//  D65Illuminantの色が(1,1,1)になるのがD65 sRGB色空間の定義
	//色温度モーフ0.5の時でも色が変わると宜しくない気がするので補正する
	//色温度モーフの上げ下げによって色合いの寒暖が出ればそれでよいので
	float3 c6500 = { 1.043217,0.983593,1.035229 };
	return ToGamma(max(mul(XYZSB(t), XYZ2RGB), 0) / c6500);
}


static float3x3 LowTempM = {
	0.0, -2902.1955373783176, -8257.7997278925690,
	0.0, 1669.5803561666639, 2575.2827530017594,
	1.0, 1.3302673723350029, 1.8993753891711275
};
static float3x3 HighTempM = {
	1745.0425298314172, 1216.6168361476490, -8257.7997278925690,
	-2666.3474220535695, -2173.1012343082230, 2575.2827530017594,
	0.55995389139931482, 0.70381203140554553, 1.8993753891711275
};


//引用元コードと同じ関数。SB曲線の結果と比較するに、ガンマでの値を返すっぽい
float3 Temp2RGB(float temperature)
{
	//↓に補正無しで6500[K]を入れた時の値…元のコードでは補正してなかったけど
	//色温度モーフ0.5の時でも色が変わると宜しくない気がするので補正することにした
	float3 c6500 = {0.988479, 0.970295, 0.989453};

    float3x3 m = (temperature <= 6500.0) ? LowTempM : HighTempM;
	float T = clamp(temperature, 1000.0, 40000.0);
	float3 C = m[0] / (T + m[1]) + m[2];
	return max(0,C/c6500);
}

static float3 TempColor = Temp2RGB(ColorTemperature);
//static float3 TempColor = RGBSB(ColorTemperature);

struct VSO { float4 pos:SV_POSITION; float2 uv:TEXCOORD; };
VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD ) { VSO vso = (VSO)0; vso.pos = pos;  vso.uv = uv; return vso; }


float3 ColorGrading(float3 c)
{
	//色温度
	float oY = RGBtoY(c);
	c = lerp(c, c * TempColor, C_ColorTemperaturePow);
	
	//明度を戻す
	float nY = RGBtoY(c);
	c *= (nY > 1e-6) ? (oY / nY) : 1;

	//Presat
	c = lerp(RGBtoY(c), c, Presaturation);

	//Lift,Gain,Gamma
	c += ((LiftColor * 2.0) - 1) * (1 - c);
	return pow(GainColor * 2.0 * saturate(c), 0.5/ GammaColor);	//saturate追加(liftが低い時、低輝度部分が負の値になるのを防ぐ)
}

#ifdef YRZ_PASS_Main
float4 PS(VSO vso) : SV_TARGET
{
	uint2 pix = vso.pos.xy;
	float2 uv = vso.uv;
	float4 I = ScreenTexture[pix];

	//悩むところではあるんだけど引用元と移植元ともにガンマsRGBなのでそのままにした
	//そもそもトーンマッピング後に使う事を念頭にしているので色空間は"よくわからない非線形空間"なのだ
	//色を整えるという本来の役割は十分果たせるのでこのままの実装とす
	I.rgb = ToGamma(saturate(I.rgb));
	
	float3 O = ColorGrading(I.rgb);

    if (C_TestMode)
    {
		if (uv.x < C_TestMode)
			O = I.rgb;
		if (abs(uv.x-C_TestMode) < 1.0/Resolution.x)
			O = 1;
    }
	
	O = saturate(ToLinear(O));

	return float4(O,I.a);
}
#endif

//ikCLUT互換CLUTの出力
#ifdef YRZ_PASS_CLUT
float4 PS(VSO vso) : SV_TARGET
{
	uint2 pos = vso.pos.xy;
	uint3 idx = { pos.x%32, pos.y, pos.x/32};
	float3 rgb = idx / 31.0;
	rgb = ColorGrading(rgb);
	return float4( rgb ,1);
}
#endif