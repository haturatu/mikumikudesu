[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
		"category" : "postprocess",
        "controllers": [{"name": "C_off","controllerName": "(self)","item": "off","type": "float"}],
		"samplers": [{ "name":"samp", "filter":"LINEAR", "addressU":"CLAMP", "addressV":"CLAMP" }],
        "passes": [ {"name":"Pass", "type":"postprocess", "vertexShader":"VS", "pixelShader":"PS"} ]
    }
}
[HLSL]
#include "../../hlsl/resources_pp.hlsli"
#include "../../hlsl/yrz.hlsli"
using namespace Dayo;
using namespace YRZ;

#ifdef __INTELLISENSE__
float C_off;
sampler samp;
#endif

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	float4 I = ScreenTexture.Sample(samp, vso.uv);
	float4 O = I;
	O.rgb = clamp(O.rgb,0,1e+3);
	O.rgb = ACESCgTonemap(O.rgb);
	O.rgb = lerp(O.rgb,I.rgb, C_off);
	return O;
}
