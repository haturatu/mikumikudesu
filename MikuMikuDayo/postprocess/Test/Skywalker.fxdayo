#include "../../hlsl/resources_PP.hlsli"
#include "../../hlsl/yrz.hlsli"
using namespace Dayo;
using namespace YRZ;

[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
		"category" : "postprocess",
        "controllers": [
			{ "name":"C_OFF", "controllerName":"(self)", "item":"off", "type":"float" },
		],
		"samplers":[
			{"name":"samp"}
		],
        "passes": [
			{
				"name":"Compo", "type":"postprocess", "pixelShader":"PS", "vertexShader":"VS"
			}
		]
    }
}
[HLSL]


#ifdef YRZ_PASS_Compo

struct VSO { float4 position:SV_POSITION; float2 uv:TEXCOORD; };
VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD ) { VSO vso = (VSO)0; vso.position = pos;  vso.uv = uv; return vso; }
float4 PS(VSO vso) : SV_TARGET
{
	uint W,H;
	Skybox.GetDimensions(W,H);

	uint2 p = vso.uv * float2(W,H);

	if (OnLoadSkybox)
		return 1;

	float pcol,prow,c;
	int mode = 0;
	if (mode == 0) {
		pcol = Skywalker[p.y*W+p.x].pdf*W;
		prow = SkywalkerRow[p.y].pdf*H;
	}
	/*
	} else if (mode == 1) {
		pcol = SkyboxPDF[p];
		prow = SkyboxPDFRow[uint2(0,p.y)];
	} else {
		float pcol1 = Skywalker[p.y*W+p.x].pdf*W;
		float prow1 = SkywalkerRow[p.y].pdf*H;
		float pcol2 = SkyboxPDF[p];
		float prow2 = SkyboxPDFRow[uint2(0,p.y)];
		pcol = abs(pcol1-pcol2);
		prow = abs(prow1-prow2);
	}
	*/
	
	//c = pcol/(2*PI);
	//c = prow/2;
	c = pcol*prow/(4*PI);

	return float4(c,c,c,1);

	//return Skybox[p];
}
#endif
