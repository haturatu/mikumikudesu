#include <resources_PP.hlsli>
#include <yrz.hlsli>
using namespace Dayo;
using namespace YRZ;

static const int ParticleCount = 128;
[YRZFX]
local base = import "liteparticle_common.jsonnet";
base {
    fx+: {
        controllers+: [
            { "name":"Thickness", "type":"float", "controllerName":"(self)", "item":"太さ" },
        ],
        textures+: [
			{ "name":"FireworkTexture", "filename":"firework.jpg", "mipmap":true },
        ],
        passes+: [
			{
				"name":"Main", "type":"rasterizer", "pixelShader":"PS", "vertexShader":"VS",
                "rasterizerDesc": { "cullMode":"none" },
                "blendDesc": {
                    "renderTarget0": { "blendEnable":true, "srcBlend":"src_alpha", "destBlend":"one", "blendOp":"add",
                        "srcBlendAlpha":"one", "destBlendAlpha":"inv_src_alpha", "blendOpAlpha":"add" }
				},
				"rasterModelTarget":"buffer", "rasterIB":"IBuf"
			}
        ]
    }
}
[HLSL]

static float3 SparkleColor = V * exp2(_Intensity*10);

struct VS_OUTPUT {
    float4 Pos      : SV_POSITION;
    float3 Normal   : TEXCOORD0;
    float3 Eye      : TEXCOORD1;
    float2 Tex      : TEXCOORD2;
    float4 Color : TEXCOORD4;
    float Phase : TEXCOORD5;
};

#include "liteparticle_common.hlsli"




//粒子の位置・速度の計算
//センターボーンによる回転・平行移動を加える前の座標で計算する
float2x3 ResolvePosVel(int iSparkle, int SparkleCount,out float phase, out bool valid)
{
    valid = true;
    float t = frac(Time*AnimSpeed);
    float3 rand = Hash3(iSparkle);
    float birthT = rand.x;  //パーティクルの生まれた時刻
    phase = t - birthT;
    phase = (phase < 0) ? phase+1 : phase;

    float rx = (rand.y - 0.5) * Arc;
    float ry = (rand.z - 0.5) * Arc;
    float3 v = float3(0,0,1);
    float3 aimLocal = mul(float4(AimBone,1),InvCenterMatrix); //ローカル座標での狙いボーンの位置
    [branch]
    if (Aim > 0.001 && length(aimLocal)>0.001) {
        v = lerp(float3(0,0,1),normalize(aimLocal),Aim); //速度ベクトル
    }
    [branch]
    if (all(v==0))
        v = float3(0,0,1);
    else
        v = normalize(v);
    v*=lerp(15,30,Hash3(iSparkle+1000));

    float3 g = mul(float3(0,-20,0),(float3x3)InvCenterMatrix);
    v = RotY(v,ry);
    v = RotX(v,rx);

    if (InjectionBone.x < 0.01) {
        //出かかり
        valid = phase < (10+InjectionBone.x)/10;
    } else if (InjectionBone.x > 0.01) {
        //出し切り
        valid = phase > InjectionBone.x/10;
    }

    float3 pos = (v * phase + g*phase*phase*0.5)*EntireSize;
    float3 vel = (v + g*phase);
    return float2x3(pos,vel);
}

//注視してる点を入れるとU方向・V方向・法線を返す
float3x3 ComputeTBN(float3 dir, float3 pos)
{
    float3 B = dir;
    float3 v = /*ViewMatrix._13_23_33;//*/ normalize(pos - CameraPosition);
    float3 T = normalize(cross(v, B));
    float3 N = cross(T,B);
    return float3x3(T,B,N);
}

//パーティクルを書き込むパス
#ifdef YRZ_PASS_Main

VS_OUTPUT VS(uint index : SV_VertexID)
{
    float4 Pos = 1e+5;
    VS_OUTPUT Out = (VS_OUTPUT)0;
    if (index < Amount) {
        int iSparkle = index / 4;      //何個目の粒か
        int iVertex = index % 4;     //粒内の何個目の頂点か
        static int SparkleCount = Amount / 4; //表示対象の粒の総数
        float phase;
        bool valid;
        float2x3 pv = ResolvePosVel(iSparkle,SparkleCount,phase,valid);
        if (valid) {
            float3 p,v;
            p = mul(float4(pv[0],1),CenterMatrix);
            v = mul(pv[1],(float3x3)CenterMatrix);
            float3x3 TBN = ::ComputeTBN(normalize(v),p+v*0.1);

            float2 uv = float2((iVertex/2+iVertex)%2,iVertex/2) - 0.5;
            float thickness = 0.3 * EntireSize * Thickness;//ResolveSize(iSparkle,phase);
            p += uv.x * TBN[0] * thickness;
            p += (uv.y+0.5) * TBN[1] * 0.3 * length(v) * EntireSize;

            Pos = float4(p,1);
            Out.Pos = mul( Pos, ViewProjectionMatrix );
            Out.Eye = CameraPosition - Pos.xyz;
            Out.Tex = uv +0.5;
            Out.Color = float4(1,1,1, dstep01(0.01,0.7,phase) * Alpha);
            Out.Phase = phase;
        } else {
            Out.Pos = mul( Pos, ViewProjectionMatrix );
        }
    } else {
        Out.Pos = mul( Pos, ViewProjectionMatrix );
    }
    return Out;
}

float4 PS(VS_OUTPUT IN) : SV_Target
{
    float4 Color;
    float2 uv = IN.Tex;

    float3 texel = ToLinear(FireworkTexture.Sample(samp, uv).rgb);
    Color.rgb = texel * SparkleColor;
    float3 hsv = RGBtoHSV(Color.rgb);
    hsv.x = H;
    hsv.y = S;
    hsv.z *= V;
    Color.rgb = HSVtoRGB(hsv);

    Color.a = smoothstep(0.5,0.45,length(uv-0.5)) * SoftParticle(IN) * IN.Color.a;

    return Color;
}

#endif
