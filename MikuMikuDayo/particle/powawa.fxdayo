#include <resources_PP.hlsli>
#include <yrz.hlsli>
using namespace Dayo;
using namespace YRZ;

static const int ParticleCount = 128;
[YRZFX]
local base = import "liteparticle_common.jsonnet";
base {
    fx+: {
        controllers+: [
            { "name":"_RingThickness", "type":"float", "controllerName":"(self)", "item":"輪の太さ" },
            { "name":"_StartSize", "type":"float", "controllerName":"(self)", "item":"根元サイズ" },
            { "name":"_EndSize", "type":"float", "controllerName":"(self)", "item":"終端サイズ" },
            { "name":"_Range", "type":"float", "controllerName":"(self)", "item":"射程" },
            { "name":"HueShift", "type":"float", "controllerName":"(self)", "item":"±H" },
        ],
        textures+: [
			{ "name":"FireworkTexture", "filename":"firework.jpg", "mipmap":true },
        ],
        passes+: [
			{
				"name":"Main", "type":"rasterizer", "pixelShader":"PS", "vertexShader":"VS",
                "rasterizerDesc": { "cullMode":"none" },
                "blendDesc": {
                    "renderTarget0": { "blendEnable":true, "srcBlend":"src_alpha", "destBlend":"one", "blendOp":"add",
                        "srcBlendAlpha":"one", "destBlendAlpha":"inv_src_alpha", "blendOpAlpha":"add" }
				},
				"rasterModelTarget":"buffer", "rasterIB":"IBuf"
			}
        ]
    }
}
[HLSL]

static float3 PowawaColor = exp2(_Intensity*10) * HSVtoRGB(float3(H,S,V));
static float RingThickness = max(1e-3,_RingThickness*0.25);
static float StartSize = Exerp(1.0/32,32,_StartSize) * 10;
static float EndSize = Exerp(1.0/32,32,_EndSize) * 10;
static float Range = Exerp(1.0/32,32,_Range) * 10;


struct VS_OUTPUT {
    float4 Pos      : SV_POSITION;
    float3 Normal   : TEXCOORD0;
    float3 Eye      : TEXCOORD1;
    float2 Tex      : TEXCOORD2;
    float Phase : TEXCOORD3;
    float Hue : TEXCOORD4;
};

#include "liteparticle_common.hlsli"



//発射方向をZ+とするフレームを作る
float3x3 CalcTBN()
{
    float3 n = CenterMatrix._31_32_33; //発射方向はZ+
    float3 A = AimBone - CenterMatrix._41_42_43;    //狙いボーンへの向き
    [branch]
    if (Aim > 0.001 && dot(A,A)>1e-6) {
        n = lerp(n,normalize(A),Aim); //速度ベクトル
    }
    [branch]
    if (any(n))
        n = normalize(n);
    else
        n = CenterMatrix._31_32_33;

    float3 Z = abs(n.z)<0.999999 ? float3(0,0,1) : float3(1,0,0);
    float3 X = cross(n, Z);
    float3 Y = normalize(cross(n, X));
    X = normalize(cross(n, Y));
    return float3x3(X,Y,n);
}


//輪の中心位置の計算。ワールド座標で
float3 ResolvePosition(float3x3 TBN, int iPowawa, int PowawaCount,out float phase, out bool valid)
{
    valid = true;
    float t = frac(Time*AnimSpeed);
    float birthT = iPowawa / float(PowawaCount);  //パーティクルの生まれた時刻
    phase = t - birthT;
    phase = (phase < 0) ? phase+1 : phase;

    float3 v = TBN[2];

    if (InjectionBone.x < 0.01) {
        //出かかり
        valid = phase < (10+InjectionBone.x)/10;
    } else if (InjectionBone.x > 0.01) {
        //出し切り
        valid = phase > InjectionBone.x/10;
    }

    return v*phase*Range*EntireSize + CenterMatrix._41_42_43;
}

//輪のサイズを計算
float ResolveSize(int iPowawa, float phase)
{
    return lerp(StartSize,EndSize,phase) * EntireSize;
}

//パーティクルを書き込むパス
#ifdef YRZ_PASS_Main

VS_OUTPUT VS(uint index : SV_VertexID)
{
    float4 Pos = 1e+5;
    VS_OUTPUT Out = (VS_OUTPUT)0;
    if (index < Amount) {
        int iPowawa = index / 4;      //何個目の輪か
        int iVertex = index % 4;     //輪内の何個目の頂点か
        static int PowawaCount = Amount / 4; //表示対象の輪の総数
        float phase;
        bool valid;
        float3x3 TBN = CalcTBN();
        float3 p = ResolvePosition(TBN, iPowawa,PowawaCount,phase,valid);
        if (valid) {
            float2 uv = float2((iVertex/2+iVertex)%2,iVertex/2) - 0.5;
            float size = ResolveSize(iPowawa,phase);
            float3 dp = (uv.x * TBN[0] + uv.y * TBN[1])* size;

            p+=dp;
            Out.Eye = CameraPosition - p;
            Out.Pos = mul( float4(p,1), ViewProjectionMatrix );
            Out.Tex = uv +0.5;
            Out.Phase = phase;
            Out.Hue = iPowawa / (float)PowawaCount;
        } else {
            Out.Pos = mul( Pos, ViewProjectionMatrix );
        }
    } else {
        Out.Pos = mul( Pos, ViewProjectionMatrix );
    }
    return Out;
}

float4 PS(VS_OUTPUT IN) : SV_Target
{
    float4 Color;
    float2 uv = IN.Tex;

    float r = length(uv-0.5);
    float k = min(0.99,Koshi);
    float3 a = smoothstep(0.5-2*RingThickness,0.5-(1+k)*RingThickness,r) * smoothstep(0.5,0.5-(1-k)*RingThickness,r);
    float3 c = PowawaColor;
    c = RGBtoHSV(c);
    c.x += (IN.Hue-0.5) * HueShift * 2;
    c = HSVtoRGB(c);

    Color.rgb = c;//pow(c, max(1e-3,Koshi*2));
    Color.a = a * Alpha * smoothstep(1,0.9,IN.Phase) * smoothstep(0,0.1,IN.Phase);
    Color.a *= SoftParticle(IN);

    return Color;
}

#endif
