#include <resources_PP.hlsli>
#include <yrz.hlsli>
using namespace Dayo;
using namespace YRZ;

static const int ParticleCount = 128;
[YRZFX]
local base = import "liteparticle_common.jsonnet";
base {
    fx+: {
        controllers+: [],
        textures+: [
			{ "name":"FireTexture", "filename":"fire.jpg", "mipmap":true },
        ],
        passes+: [
			{
				"name":"Main", "type":"rasterizer", "pixelShader":"PS", "vertexShader":"VS",
                "rasterizerDesc": { "cullMode":"none" },
                "blendDesc": {
                    "renderTarget0": { "blendEnable":true, "srcBlend":"src_alpha", "destBlend":"one", "blendOp":"add",
                        "srcBlendAlpha":"one", "destBlendAlpha":"inv_src_alpha", "blendOpAlpha":"add" }
				},
				"rasterModelTarget":"buffer", "rasterIB":"IBuf"
			}
        ]
    }
}
[HLSL]

static float3 FireColor = V * exp2(_Intensity*10);

struct VS_OUTPUT {
    float4 Pos      : SV_POSITION;
    float3 Normal   : TEXCOORD0;
    float3 Eye      : TEXCOORD1;
    float2 Tex      : TEXCOORD2;
    float4 Color : TEXCOORD4;
    float Phase : TEXCOORD5;
};

#include "liteparticle_common.hlsli"


static float NoriNori = 0;

float NoriSine(float t)
{
    return lerp( sin(t), (sin(t) + sin(3*t)/3) * 0.75 ,NoriNori);
}


//煙粒子の位置の計算
//センターボーンによる回転・平行移動を加える前の座標で計算する
float3 ResolvePosition(int iFire, int FireCount,out float phase, out bool valid)
{
    valid = true;
    float t = frac(Time*AnimSpeed);
    float3 rand = Hash3(iFire);
    float birthT = rand.x;  //パーティクルの生まれた時刻
    phase = t - birthT;
    phase = (phase < 0) ? phase+1 : phase;

    float rx = (rand.y - 0.5) * Arc;
    float ry = (rand.z - 0.5) * Arc;
    float3 v = float3(0,0,1);
    float3 aimLocal = mul(float4(AimBone,1),InvCenterMatrix); //ローカル座標での狙いボーンの位置
    [branch]
    if (Aim > 0.001 && length(aimLocal)>0.001) {
        v = lerp(float3(0,0,1),normalize(aimLocal),Aim); //速度ベクトル
    }
    [branch]
    if (all(v==0))
        v = float3(0,0,1);
    else
        v = normalize(v);
    float3 rand2 = Hash3(iFire+1000);
    v*=lerp(0.5,1,rand2.x);

    float3 g = float3(0,0,-1);
    v = RotY(v,ry);
    v = RotX(v,rx);

    if (InjectionBone.x < 0.01) {
        //出かかり
        valid = phase < (10+InjectionBone.x)/10;
    } else if (InjectionBone.x > 0.01) {
        //出し切り
        valid = phase > InjectionBone.x/10;
    }

    float3 p = (v * pow(phase,0.9) * 25 + g*phase*phase)*EntireSize;
    p.x += NoriSine((t+rand2.y) * 2*PI) /* sin(phase*PI) */* rand2.z * 0.5;

    return p;
}

//粒子のサイズを計算
float ResolveSize(int iFire, float phase)
{
    float rand = Hash3(iFire+200);
    float2 s;
    if (rand.x < 4.0/7)
        s = float2(0.1,5);
    else if (rand.x < 6.0/7)
        s = float2(0.2,10);
    else
        s = float2(0.4,20);
    return lerp(s.x,s.y,sin(phase*PI)) * EntireSize;
}


//パーティクルを書き込むパス
#ifdef YRZ_PASS_Main

VS_OUTPUT VS(uint index : SV_VertexID)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;
	float4 Pos = 1e+5;

    if (index < Amount) {
        int iFire = index / 4;      //何個目の煙か
        int iVertex = index % 4;     //煙内の何個目の頂点か
        static int FireCount = Amount / 4; //表示対象のビームの総数
        float phase;
        bool valid;
        float3 dPos = ResolvePosition(iFire,FireCount,phase,valid);
        if (valid) {
            float3 p;
            p = mul(float4(dPos,1),CenterMatrix);

            float2 uv = float2((iVertex/2+iVertex)%2,iVertex/2) - 0.5;
            float size = ResolveSize(iFire,phase);

            Pos = float4(p,1);
			Pos.xyz += uv.x * ViewMatrix._11_21_31 * size;
			Pos.xyz += uv.y * ViewMatrix._12_22_32 * size;
			Out.Pos = mul( Pos, ViewProjectionMatrix );
			Out.Eye = CameraPosition - Pos.xyz;
            Out.Tex = uv +0.5;
            Out.Color = float4(1,1,1, dstep01(0.1,0.9,phase) * Alpha);
            Out.Phase = phase;
        } else {
            Out.Pos = mul( Pos, ViewProjectionMatrix );
        }
    } else {
        Out.Pos = mul( Pos, ViewProjectionMatrix );
    }
    return Out;
}

//マスクを作成
float Maskin(float2 uv)
{
    float2 f = uv-0.5;
    float2 t = float2(abs(f.x*2) + (f.y > 0 ? f.y : 0),f.y);
    float c = smoothstep(0.5,0.25,length(t));  //楕円マスク
    return c;
}

float4 PS(VS_OUTPUT IN) : SV_Target
{
    float4 Color;
    float2 uv = IN.Tex;

    float3 texel = FireTexture.Sample(samp, uv).rgb;
    Color.rgb = max(pow(texel,Koshi) * FireColor * Koshi * 0.01, 0);
    float3 hsv = RGBtoHSV(Color.rgb);
    hsv.x += H;
    hsv.y *= S;
    hsv.z *= V;
    Color.rgb = HSVtoRGB(hsv);

    Color.a = Maskin(uv) * SoftParticle(IN) * IN.Color.a;
    return Color;
}

#endif
