#include "../hlsl/yrz.hlsli"
#include "../hlsl/resources_deform.hlsli"
//#include "../hlsl/resources_pp.hlsli"
using namespace Dayo;
using namespace YRZ;

//パーティクルの情報
struct Particle {
    float3 P;
    float phase;
    float3 V;
};

#define CATEGORY 0
#define MAX_PARTICLES 16384
[YRZFX]
local CATEGORY = 0;
local MAX_PARTICLES = 16384;

local DeformPasses = [
    { "name":"Vertex", "type":"compute", "computeShader":"CS"}
];
local PPPasses = [
    { "name":"SetBuf","type":"compute","computeShader":"CS", "UAV":[{"name":"VBuf"}, {"name":"IBuf"}],
        "outputSize":{"absolute":true, "dimension":1, "width":MAX_PARTICLES}, "conditions":["OnLoad"] },
    { "name":"Vertex", "type":"compute", "computeShader":"CS", "UAV":[{"name":"VBuf"}],
        "outputSize":{"base":"VBuf"} },
    { "name":"Raster", "type":"rasterizer", "vertexShader":"VS", "pixelShader":"PS",
        "rasterModelTarget":"buffer","rasterVB":"VBuf", "rasterIB":"IBuf",
        "rasterizerDesc":{"cullMode":"none"},
        "blendDesc": {
            "renderTarget0": { "blendEnable":true, "srcBlend":"one", "destBlend":"one", "blendOp":"add",
                "srcBlendAlpha":"one", "destBlendAlpha":"inv_src_alpha", "blendOpAlpha":"add" }
        }
    }
];

local CategoryStr = if CATEGORY==0 then "deform" else "postprocess";
local PassesStr = if CATEGORY==0 then DeformPasses else PPPasses;
{
    "fx": {
        "cereal_class_version": 0,
		"category" : CategoryStr,
        "controllers": [
			{ "name":"C_Center", "controllerName":"(self)", "item":"センター", "type":"float4x4" },
            { "name":"AimBone", "controllerName":"(self)", "item":"狙い", "type":"float3"},
            { "name":"Aim", "controllerName":"(self)", "item":"狙い有効", "type":"float"},
            { "name":"Gravity", "controllerName":"(self)", "item":"重力", "type":"float3"},
            { "name":"_Amount", "controllerName":"(self)", "item":"少なく", "type":"float"},
            { "name":"_AnimSpeed", "controllerName":"(self)", "item":"速度", "type":"float"},
            { "name":"DeltaAnimSpeed", "controllerName":"(self)", "item":"±速度", "type":"float"},
            { "name":"_Arc", "controllerName":"(self)", "item":"広がり", "type":"float"},
            { "name":"Drag", "controllerName":"(self)", "item":"抵抗", "type":"float"},
            { "name":"Turbulence", "controllerName":"(self)", "item":"乱流", "type":"float"},
            { "name":"TurbulenceFreq", "controllerName":"(self)", "item":"乱流の細かさ", "type":"float"},
            { "name":"_TurbulenceSpeed", "controllerName":"(self)", "item":"乱流の速さ", "type":"float"},
            { "name":"Length", "controllerName":"(self)", "item":"長さ", "type":"float"},
            { "name":"DeltaLength", "controllerName":"(self)", "item":"±長さ", "type":"float"},
            { "name":"_ParticleSize", "controllerName":"(self)", "item":"サイズ", "type":"float"},
            { "name":"DeltaParticleSize", "controllerName":"(self)", "item":"±サイズ", "type":"float"},
            { "name":"SpawnRate", "controllerName":"(self)", "item":"勢い", "type":"float"},
            { "name":"ActiveSpawn", "controllerName":"(self)", "item":"動き連動", "type":"float"},
            { "name":"CentrifugalPlus", "controllerName":"(self)", "item":"遠心力+", "type":"float"},
            { "name":"CentrifugalMinus", "controllerName":"(self)", "item":"遠心力-", "type":"float"},
            { "name":"Whirlwind", "controllerName":"(self)", "item":"つむじ風", "type":"float"},
            { "name":"WhorlRadius", "controllerName":"(self)", "item":"つむじ半径", "type":"float3"},
            { "name":"WhorlBone", "controllerName":"(self)", "item":"つむじ", "type":"float4x4"},
            { "name":"_H", "controllerName":"(self)", "item":"H", "type":"float"},
            { "name":"DeltaHue", "controllerName":"(self)", "item":"±H", "type":"float"},
            { "name":"_S", "controllerName":"(self)", "item":"S", "type":"float"},
            { "name":"_V", "controllerName":"(self)", "item":"V", "type":"float"},
            { "name":"_A", "controllerName":"(self)", "item":"透明度", "type":"float"},
            { "name":"_Intensity", "controllerName":"(self)", "item":"明るく", "type":"float"},
            { "name":"_Koshi", "controllerName":"(self)", "item":"コシ", "type":"float"},
            { "name":"KiraKira", "controllerName":"(self)", "item":"キラキラ度", "type":"float"},
            { "name":"_aH", "controllerName":"(self)", "item":"環境H", "type":"float"},
            { "name":"_aS", "controllerName":"(self)", "item":"環境S", "type":"float"},
            { "name":"_aV", "controllerName":"(self)", "item":"環境V", "type":"float"},
            { "name":"Textured", "controllerName":"(self)", "item":"テクスチャ", "type":"float"},
            { "name":"Reset", "controllerName":"(self)", "item":"リセット", "type":"float"},
            { "name":"Ground", "controllerName":"(self)", "item":"床の高さ", "type":"float3"},
            { "name":"_TouchGround", "controllerName":"(self)", "item":"床有効", "type":"float"},
            { "name":"_FloorFriction", "controllerName":"(self)", "item":"床の摩擦", "type":"float"},
            { "name":"Bounce", "controllerName":"(self)", "item":"弾性", "type":"float"},
            { "name":"C_DisplayMode", "controllerName":"(self)", "item":"表示モード", "type":"float"}
		],
        "buffers" : [
            { "name":"Particles", "type":"Particle", "elemSize":28, "size":{"absolute":true, "width":MAX_PARTICLES}, "view":"UAV" },
            { "name":"Computer", "type":"int4", "size":{"absolute":true, "width":1 }, "view":"UAV" },
            { "name":"CenterBuffer", "type":"float4", "size":{"absolute":true, "width":1}, "view":"UAV"},
            { "name":"VBuf", "type":"Vertex", "size":{"absolute":true, "width":MAX_PARTICLES*4}, "view":"UAV"},
            { "name":"IBuf", "type":"uint", "size":{"absolute":true, "width":MAX_PARTICLES*6}, "view":"UAV"}
        ],
        "passes": [
            { "name":"Compute", "type":"compute", "computeShader":"CS" , "outputSize":{"base":"Computer"}, "UAV":[{"name":"Computer"}], "numthreads":{"x":1} },
            { "name":"Particle", "type":"compute", "computeShader":"CS", "outputSize":{"base":"Particles"}, "UAV":[{"name":"Particles"}] }
        ] + PassesStr + [
            { "name":"CamRec", "type":"compute", "computeShader":"CS", "outputSize":{"base":"CenterBuffer"}, "UAV":[{"name":"CenterBuffer"}], "numthreads":{"x":1} },
        ]
    }
}
[HLSL]

static float3 CenterPosition = C_Center._41_42_43;
static int Amount = max(min((round((1-_Amount) * MAX_PARTICLES)),MAX_PARTICLES) * 4,0);   //表示に使う頂点の数
static int ParticleCount = Amount/4;
static float AnimSpeed = (Exerp(1,16,_AnimSpeed)-1) * 4;
static float Arc = _Arc * PI;
static float TurbulenceSpeed = Exerp(1,16,_TurbulenceSpeed);
static float ParticleSize = Exerp(0.125,8,_ParticleSize);
static float Centrifugal = 3 * Exerp(1,100,CentrifugalPlus-CentrifugalMinus);
static float Alpha = 1-_A;
static float3 LightAmbientLinear = ToLinear(LightColor);
static float3 SmokeColor = any(float3(_H,_S,_V)) ? HSVtoRGB(float3(_H,min(0.999,_S),_V)) * exp2(_Intensity*10) : LightAmbientLinear * exp2(_Intensity*10);
static float Koshi = lerp(1,10,_Koshi);
static float3 AmbientColor = HSVtoRGB(float3(_aH,min(0.999,_aS),_aV)) * exp2(_Intensity*10);
static bool TouchGround = _TouchGround >= 1e-3;
static float FloorFriction = 1-clamp(_FloorFriction, 0,0.999);


//デフォルト値の設定
//パーティクルの表示モード
// 0 : 回転する四角ポリゴン
// 1 : 長さ付きビルボード
static int DisplayMode = (C_DisplayMode >= 0.5);

float3 hash(float3 x)
{
    return Hash3(x*1024)*2-1;
}

//inigo quilez氏 "Noise - Gradient - 3D - Deriv"
//https://www.shadertoy.com/view/4dffRHより
//curlが欲しいだけなので勾配のみ返すように改変
float3 dNoise(float3 x )
{
    // grid
    float3 i = floor(x);
    float3 w = frac(x);
    
    // quintic interpolant
    float3 u = w*w*w*(w*(w*6.0-15.0)+10.0);
    float3 du = 30.0*w*w*(w*(w-2.0)+1.0);
    
    // gradients
    float3 ga = hash( i+float3(0.0,0.0,0.0) );
    float3 gb = hash( i+float3(1.0,0.0,0.0) );
    float3 gc = hash( i+float3(0.0,1.0,0.0) );
    float3 gd = hash( i+float3(1.0,1.0,0.0) );
    float3 ge = hash( i+float3(0.0,0.0,1.0) );
	float3 gf = hash( i+float3(1.0,0.0,1.0) );
    float3 gg = hash( i+float3(0.0,1.0,1.0) );
    float3 gh = hash( i+float3(1.0,1.0,1.0) );
    
    // projections
    float va = dot( ga, w-float3(0.0,0.0,0.0) );
    float vb = dot( gb, w-float3(1.0,0.0,0.0) );
    float vc = dot( gc, w-float3(0.0,1.0,0.0) );
    float vd = dot( gd, w-float3(1.0,1.0,0.0) );
    float ve = dot( ge, w-float3(0.0,0.0,1.0) );
    float vf = dot( gf, w-float3(1.0,0.0,1.0) );
    float vg = dot( gg, w-float3(0.0,1.0,1.0) );
    float vh = dot( gh, w-float3(1.0,1.0,1.0) );
	
    // interpolations
    return float3( ga + u.x*(gb-ga) + u.y*(gc-ga) + u.z*(ge-ga) + u.x*u.y*(ga-gb-gc+gd) + u.y*u.z*(ga-gc-ge+gg) + u.z*u.x*(ga-gb-ge+gf) + (-ga+gb+gc-gd+ge-gf-gg+gh)*u.x*u.y*u.z +   // derivatives
                 du * (float3(vb,vc,ve) - va + u.yzx*float3(va-vb-vc+vd,va-vc-ve+vg,va-vb-ve+vf) + u.zxy*float3(va-vb-ve+vf,va-vb-vc+vd,va-vc-ve+vg) + u.yzx*u.zxy*(-va+vb+vc-vd+ve-vf-vg+vh) ));
}


//Return the rotation of the vector field A at p
float3 curl(float3 p)
{
	//dNoise is a function that returns ∇f|p for a scalar field f at p
	//scalar field f is borrowed from iq's gradient noise function
	//dNoise(p) is same as iq's noised(p).yzw

	//Combine three scalar fields f0,f1,f2 into a 3D vector field A (A.x=f0, A.y=f1, A.z=f2)
	float3x3 M; //Tensor ∇A
	M[0] = dNoise(p);		//(∂A.x/∂x,∂A.x/∂y,∂A.x/∂z)
	M[1] = dNoise(p+10000);	//(∂A.y/∂x,∂A.y/∂y,∂A.y/∂z)
	M[2] = dNoise(p+20000);	//(∂A.z/∂x,∂A.z/∂y,∂A.z/∂z)
	//return M[0];	//∇f
	return float3(M._32-M._23, M._13-M._31, M._21-M._12);	//∇xA
}



//粒子ごとの実際の速度
float ActualSpeed(int id)
{
    return AnimSpeed * lerp(1,Hash3(uint3(id,811,62)).x,DeltaAnimSpeed);
}

//このIDの粒子は現在のフレームで生成されたばかりか？
bool IsSpawning(int id)
{
    int4 comp = Computer[0];
    int cur = comp.r;
    int prev = comp.g;

    if (cur == prev)
        return false;

    if (cur > prev) {
        return (id < cur) && (id >= prev);
    } else {
        //return false;
        return (id < cur) || (id >= prev);
    }
}


//センターボーンの移動量
float3 DCenterDT() {
    float3 prevCP = CenterBuffer[0].xyz;
    return (CenterPosition-prevCP) / DTime;
}

//センターボーンの移動量によって作られる接空間
float3x3 DCenterFrame(float3 dcdt) {
    if (any(dcdt)) {
        float3 n = normalize(dcdt);
        float3 Z = abs(n.z)<0.999999 ? float3(0,0,1) : float3(1,0,0);
        float3 X = cross(n, Z);
        float3 Y = normalize(cross(n, X));
        X = normalize(cross(n, Y));
        return float3x3(X,Y,n);
    } else {
        return Identity33;
    }
}
 //速度による生成数への影響度
 float ActualSpawnRate() {
    if (OnStart || Reset > 0.5)
        return 0;
    float3 DC = DCenterDT();
    return SpawnRate * lerp(1,min(length(DC)*0.01,1),ActiveSpawn);
}

//現在のフレームでのパーティクル精製数
int SpawnCount() {
    //int sr =  ParticleCount * DTime * ActualSpawnRate();

    //↑の元のコードの問題点：sr=0に丸められるとパーティクルが出なくなる
    //解決法：端数を確率的に切り上げる
    float sr =  ParticleCount * DTime * ActualSpawnRate();
    if (DTime > 0)
        sr += GoldenHash11(Time/DTime) < frac(sr);

    return int(sr);
}

//注視してる点を入れるとU方向・V方向・法線を返す
float3x3 ComputeTBN(float3 dir, float3 pos)
{
    float3 B = dir;
    float3 v = /*ViewMatrix._13_23_33;//*/ normalize(pos - CameraPosition);
    float3 T = normalize(cross(v, B));
    float3 N = cross(T,B);
    return float3x3(T,B,N);
}

//https://www.iquilezles.org/www/articles/distfunctions/distfunctions.htmより
float sdCapsule( float3 p, float3 a, float3 b, float r )
{
  float3 pa = p - a, ba = b - a;
  float h = clamp( dot(pa,ba)/dot(ba,ba), 0.0, 1.0 );
  return length( pa - ba*h ) - r;
}

//線分ABのうちPに最も近い点
float3 NearestPointTube(float3 P, float3 A, float3 B)
{
	float3 D = B - A;
	float d2 = dot(D,D);
	if (d2 == 0)
		return A;
	float t = (dot(D,P)-dot(A,D))/d2;
	t = saturate(t);
	return lerp(A,B,t);
}




//障害物の解決
/*
void ResolveBounds(inout float3 P, inout float3 V, float size)
{
    const float eps = 1e-3;

    for (int i=0; i<OBSTACLES; i++) {
        float d = sdCapsule(P,O_Heads[i],O_Tails[i],O_Radii[i]+size/2);
        if (d < 0) {
            float3 np = NearestPointTube(P, O_Heads[i],O_Tails[i]);
            float3 N = normalize(P-np);
            P += N * -(d+eps);
            V = V - (1+O_Elastic[i]) * dot(N, V) * N;
        }
    }
}
*/

//実際の1フレーム当たりの移動量を計算する
//Vはturbulent無しの運動時の速度、この関数を通すとcurl noiseに乗せた時の速度とブレンドされる
float3 ActualMovement(float3 P, float3 V, float dt, float speed, float size)
{
    //床に近い時は乱流の影響を受けない
    float marginY = DisplayMode ? size/2 : 0.05;
    if (TouchGround && P.y <= Ground.y + marginY*2) {
        return V * dt;
    }

    float freq = lerp(0.1,1,TurbulenceFreq);
    float3 turbV = curl(P*freq) * TurbulenceSpeed; //乱流

    return lerp(V,turbV, Turbulence) * dt;
}

//回転四角形用。法線とuvに対応する中心からの位置のズレを計算。uvは中心を0として端を±0.5にしてある
//movement ... 移動量計算モード。壁との接触判定やdPの計算不要
float3 ResolveNormal(int id, float2 uv, float3 P, out float3 dP, float size, bool movement = false, float3 V = 0)
{
    float3 axis = normalize(Hash3(uint3(id,71,542))-0.5);
    float2 Xi = Hash3(uint3(id,93,162)).xy;
    float t = Time*lerp(1,10,Xi.y)+Xi.x*2*PI;
    float3 NFly = RotAxis(float3(0,0,1),axis,t);
    [branch]
    if (movement) {
        dP = 0;
        return NFly;
    } else {
        if (TouchGround) {
            float h = smoothstep(size,size*0.05,abs(P.y-Ground.y)); //高さ係数
            float s = smoothstep(5,0.5,length(V));          //速度係数
            float b = min(h,s); //b=1の時は寝てる、0の時は飛んでる
            //飛んでいる場合のdPを計算。地面にめり込んでる分は浮かす
            float3 dPFly = RotAxis(float3(uv,0),axis,t);
            float toBottom = max(abs(RotAxis(float3(0.5,0,0),axis,t).y),abs(RotAxis(float3(0,0.5,0),axis,t).y));
            float meri = Ground.y - (P.y - toBottom);   //どれだけ地面にめり込むか
            dPFly.y += max(meri,0);
            //接地している場合のdPを計算
            float3 dPGround = RotAxis(float3(uv.x,0,uv.y),float3(0,1,0),Xi.x*2*PI);
            //飛んでる場合、寝てる場合の間をとる
            dP = lerp(dPFly, dPGround, b) * size;
            float3 N = normalize(lerp(NFly,float3(0,1,0),b));
            return N;
        } else {
            dP = RotAxis(float3(uv,0),axis,t) * size;
            return NFly;
        }
    }
}

//粒子のサイズを計算
float ResolveSize(int iSmoke, float phase)
{
    float rand = Hash3(uint3(iSmoke,200,92)).x;
    float s = 4;
    if (rand > 4/7.75) {
        s = 0.25;
    } else if (rand > 2/7.75) {
        s = 0.5;
    } else if (rand > 1/7.75) {
        s = 1;
    } else if (rand > 0.5/7.75) {
        s = 2;
    }

    return ParticleSize * lerp(1,s,DeltaParticleSize);
}


//デフォルトの移動関数
Particle DefaultMovin(int id)
{
    Particle Pcl = Particles[id];
    float3 V = Pcl.V;
    float3 P = Pcl.P;
    float life = Pcl.phase;

    if (OnStart || id >= ParticleCount || Reset >= 0.5) {
        //再生開始時の初期化, 無効なパーティクルの処理
        P = -100000;
        life = -1;
        V = 0;
    } else {
        //有効なパーティクル
        if (IsSpawning(id)) {
            //初期化
            float3 dc = DCenterDT();    //1秒あたりのセンターボーンの移動量
            P = CenterPosition + (Hash3(uint3(id,655,902))-0.5)*0.1 - Hash3(uint3(id,1,62489)).x*dc*DTime;    //移動跡上のどこかに生成
            life = 1;
            float cp,sp,ct,st;
            float2 Xi = Hash3(uint3(id,371,frac(Time*0.114514)*1401)).xy;
            sincos((Xi.x-0.5)*2*PI,sp,cp);   //φ
            sincos(Xi.y*Arc,st,ct);   //θ
            float3 dir = float3(cp*st,sp*st,ct);
            float3 Va = mul(dir,DCenterFrame(dc)) * length(dc) * DTime * Centrifugal;   //*xを付けないとなんか物足りない
            float3 Vp = mul(dir,(float3x3)C_Center) * ActualSpeed(id);  //オリジナルではZ-の方向にパーティクルが出ていたが、Z+の方向に飛ばす事にした
            V = lerp(Vp,Va,ActiveSpawn);
        } else {
            //更新
            float size = ResolveSize(id,life);
            float3 A = Gravity;   //加速度
            if (Aim > 1e-4) {   //狙い
                A += normalize(AimBone - P) * Aim * 10;
            }

            //床1, 床についてたら摩擦を掛ける
            float marginY = DisplayMode ? size/2 : 0.05;
            
            /*
            if (TouchGround) {
                if (P.y < Ground.y + marginY + 1e-3) {
                    A = 0;
                    V.y = 0;
                    V.xz *= pow(FloorFriction,DTime); //摩擦
                }
            }
            */

            
            V += A*DTime;
            float3 N = {0,1,0};
            if (DisplayMode)
                V *= pow(max(1-Drag,1e-3),DTime);   //抵抗
            else {
                float3 dmy;
                N = ResolveNormal(id,0,0,dmy,1,true);
                V = V - N * dot(N,V) * (1 - pow(max(1-Drag,1e-3),DTime));   //面の法線方向に空気抵抗
            }
            

            float3 dP;
            dP = ActualMovement(P,V,DTime,ActualSpeed(id), size);   //乱流項を加味する
            //P += dP;

            float3 PrevP = P;
            //つむじ風
            if (abs(Whirlwind) >= 1e-3) {
                float torRadius = length(WhorlRadius);
                float3 torAxis = WhorlBone._21_22_23;
                float3 torCenter = WhorlBone._41_42_43;
                float3 R = torCenter-P;
                R -= dot(R,torAxis)*torAxis;    //粒子→つむじ軸
                float lenR = length(R);
                R = normalize(R);
                float3 torF = cross(torAxis,R);  //円周方向の力
                torF += (lenR-torRadius)*R;      //半径方向の力(torRadiusの所で気圧勾配が0になるとする)
                float3 torV = torF * Whirlwind * 10 * DTime;
                if (TouchGround) {
                    torV += float3(0,1,0) * (smoothstep(Ground.y+10,Ground.y,P.y) * DTime * Hash3(uint3(Time*500,839,1221)).x * 4);   //地面付近の上昇気流
                }
                if (DisplayMode==0)
                    torV = torV + N * dot(N,torV) * (1 - pow(max(1-Drag,1e-3),DTime));    //抵抗が大きい場合、竜巻による風の向きと等しいとより加速される
                
                V += torV;
                P += dP + torV * DTime;
            } else {
                P += dP;
            }


            //障害物
            //ResolveBounds(P,V,size);

            //床1.5、床との衝突判定
            if (TouchGround) {
                float t = Ground.y + marginY;    //高さ閾値
                if (PrevP.y > t && P.y <= t) {
                    V.y = -V.y*Bounce;
                }
            }

            //床2、障害物によって床下に押し下げられるのを防ぐ
            /*
            if (TouchGround) {
                if (P.y < Ground.y + marginY) {
                    P.y = Ground.y + marginY;
                    V *= pow(FloorFriction,DTime); //摩擦
                    if (length(V)<1)
                        V = 0;
                    A = 0;
                }
            }
            */
            if (TouchGround) {
                //いつまでも止まらないのを修正                
                if (P.y <= Ground.y + marginY) {
                    P.y = Ground.y;
                    V *= pow(FloorFriction,DTime); //摩擦
                    if (length(V)<1 && FloorFriction)
                        V = 0;
                    A = 0;
                }
            }

            //ライフを減らす…勢い依存
            life -= DTime * SpawnRate;
        }
    }

    Pcl.P = P;
    Pcl.phase = life;
    Pcl.V = V;
    return Pcl;
}


#ifdef YRZ_PASS_Compute
YRZ_NUMTHREADS
void CS( uint3 id : SV_DispatchThreadID )
{
    //勢い制御
    if (OnStart || Reset > 0.5) {
        Computer[0] = 0;
    } else {
        int hist = Computer[0].r;
        Computer[0] = int4((int)(hist + SpawnCount()) % ParticleCount, hist, 0,0);
    }
}
#endif

//軌道の計算
#ifdef YRZ_PASS_Particle
YRZ_NUMTHREADS
void CS( uint3 id : SV_DispatchThreadID )
{
    int i = id.x;
    Particles[i] = DefaultMovin(i);
}
#endif


//頂点の計算
#ifdef YRZ_PASS_Vertex

YRZ_NUMTHREADS
void CS( uint3 id : SV_DispatchThreadID )
{
    #if CATEGORY == 0
    	Vertex v = VB[id.x];
    #else
        Vertex v = VBuf[id.x];
    #endif
    int iSmoke = id.x / 4;      //何個目のツブか
    int iVertex = id.x % 4;     //ツブ内の何個目の頂点か

    Particle Pcl = Particles[iSmoke];
    float3 P = Pcl.P;
    float3 V = Pcl.V;
    float phase = Pcl.phase; //phase ... 生まれた瞬間が1、寿命が尽きたら0、マイナスなら無効な粒子を示す

    float3 dP = 0;
    if (phase > 0 && phase <= 1) {
        float size = ResolveSize(iSmoke,phase);
        float2 uv = v.uv - 0.5;
        if (DisplayMode) {
            //ビルボードモード
            float len = lerp(0,10,Length) * lerp(1,Hash3(uint3(iSmoke,182,523)).x,DeltaLength);
            float3 headP = P + ActualMovement(P,V,1.0/30,ActualSpeed(iSmoke), size) * len;    //パーティクルの長さは30FPS基準で揃える(編集時と出力時で見た目が変わるのを防ぐため)
            float3 dir = (len<1e-3) ? ViewMatrix._11_21_31 : normalize(headP - P);
            float3x3 TBN = ::ComputeTBN(dir, (headP+P)/2);
            dP = uv.y * TBN[0] * size + uv.x * TBN[1] * (length(headP-P) + size);
            v.normal = TBN[2];
        } else {
            //回転する4角ポリゴンモード
            v.normal = ResolveNormal(iSmoke, uv*size, P, dP, size, false, V);
        }
        v.position = P + dP;
    } else {
        v.position = float4(-1e+5,-1e+5,-1e+5,-1); //どこか画面外
        v.normal = float3(0,0,1);   //てきとう
    }
    v.normal = -v.normal;
    v.tangent = YRZ::ComputeTBN(v.normal)[0];
    v.exuv[0] = float4((Hash4(iSmoke).x-0.5) * DeltaHue + _H, _S*2, _V, 1);
    
    #if CATEGORY == 0
        OutBuf[id.x] = v;
    #else
        VBuf[id.x] = v;
    #endif
}
#endif

#ifdef YRZ_PASS_CamRec
YRZ_NUMTHREADS
void CS( uint3 id : SV_DispatchThreadID )
{
    //センターボーン記録
    if (OnStart || Reset > 0.5) {
        CenterBuffer[0] = float4(CenterPosition,0);
    } else {
        float3 prevP = CenterBuffer[0].xyz;
        CenterBuffer[0] = float4(lerp(prevP,CenterPosition,0.5),0);
    }
}
#endif



/*** 以下、ポストプロセス用パス ***/

//パーティクルのメッシュ全体を出力するコンピュートシェーダ
#ifdef YRZ_PASS_SetBuf
YRZ_NUMTHREADS
void CS( uint3 id : SV_DispatchThreadID )
{
	uint i = id.x;

	//頂点インデクス
	//MMDモデルはTRIANGLELIST。3つの頂点インデクスで1つの三角形が定義される
	uint p = i*6;
	uint q = i*4;
	IBuf[p] = q;
	IBuf[p+1] = q+1;
	IBuf[p+2] = q+3;
	IBuf[p+3] = q+1;
	IBuf[p+4] = q+2;
	IBuf[p+5] = q+3;

	//↓はVertexShaderで代入してもいいがこっちで書いた方が何かと捗るので
	VBuf[q].uv = float2(0,0);
	VBuf[q+1].uv = float2(1,0);
	VBuf[q+2].uv = float2(1,1);
	VBuf[q+3].uv = float2(0,1);
}
#endif


#ifdef YRZ_PASS_Raster
struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD0;
	float3 eye:TEXCOORD2;
	float3 color:TEXCOORD3;
};

//色変え処理用ヘルパー
float3 HueShift(float3 rgb, float Xi)
{
    float3 hsv = RGBtoHSV(rgb);
    hsv.x += (Xi-0.5)*DeltaHue; 
    return HSVtoRGB(hsv);
}

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD, float3 normal:NORMAL, uint index:SV_VertexID )
{
    VSO vso = (VSO)0;
	vso.position = mul(pos,ViewProjectionMatrix);
	vso.eye = CameraPosition - pos.xyz;
	vso.uv = uv;

    float4 xi = Hash4(index/4);
    vso.color = HueShift(SmokeColor, xi.x);
    
    //キラキラ係数
    float k = max(sin(Time*KiraKira*lerp(5,15,xi.z)+xi.y*2*PI),1e-3);
    k = pow(k,KiraKira*20)*(KiraKira*20);
    vso.color *= 1 + max(0,lerp(1,k,KiraKira)-1);

	return vso;
}

float4 PS(VSO vso, uint iFace:SV_PrimitiveID, bool vface:SV_IsFrontFace) : SV_TARGET
{
	//Zテスト
	uint2 p = vso.position.xy;
	float z = NormalDepth[p].w;
	float pz = vso.position.w;
	if (pz > z && z!=0 || pz < 10)  //近方クリッピングつき
		discard;

	float4 O = 1;
	O.rgb = vso.color;
	float soft = smoothstep(0,10,z-pz);	//Z値が近い場合は薄める(ソフトパーティクル)
	if (!z)
		soft = 1;
	
    
    O.rgb *= smoothstep(0.51,0.5,length(vso.uv-0.5)) * soft * vso.color;
	O.a = 1;

    NormalDepth[p].w = min(NormalDepth[p].w, vso.position.w);
	return O;
}

#endif