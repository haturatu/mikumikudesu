#include <resources_PP.hlsli>
#include <yrz.hlsli>
using namespace Dayo;
using namespace YRZ;

static const int ParticleCount = 128;
[YRZFX]
local base = import "liteparticle_common.jsonnet";
base {
    fx+: {
        controllers+: [
            { "name":"Thickness", "type":"float", "controllerName":"(self)", "item":"太さ" },
        ],
        textures+: [
			{ "name":"SparcleTexture", "filename":"teslacoil.jpg", "mipmap":true },
        ],
        passes+: [
			{
				"name":"Main", "type":"rasterizer", "pixelShader":"PS", "vertexShader":"VS",
                "rasterizerDesc": { "cullMode":"none" },
                "blendDesc": {
                    "renderTarget0": { "blendEnable":true, "srcBlend":"src_alpha", "destBlend":"one", "blendOp":"add",
                        "srcBlendAlpha":"one", "destBlendAlpha":"inv_src_alpha", "blendOpAlpha":"add" }
				},
				"rasterModelTarget":"buffer", "rasterIB":"IBuf"
			}
        ]
    }
}
[HLSL]

static float3 SparkleColor = V * exp2(_Intensity*10);

struct VS_OUTPUT {
    float4 Pos      : SV_POSITION;
    float3 Normal   : TEXCOORD0;
    float3 Eye      : TEXCOORD1;
    float2 Tex      : TEXCOORD2;
    float4 Color : TEXCOORD3;
    float Phase : TEXCOORD4;
};

#include "liteparticle_common.hlsli"


//向きを狙いボーンなどから計算
//稲妻の場合は射出方向は狙いボーンに向けない
float3 ResolveDirection(float2 rand, out float3 aimLocal)
{
    float rx = (rand.x - 0.5) * Arc;
    float ry = (rand.y - 0.5) * Arc;
    float3 v = float3(0,0,1);
    aimLocal = mul(float4(AimBone,1),InvCenterMatrix); //ローカル座標での狙いボーンの位置
    v = RotY(v,ry);
    v = RotX(v,rx);
    return v;
}

#define JOINTS 8

float3 JointPos(float iJoint, float3 dir, float3 aimPos, float seed)
{
    float3 p=0;

    for (int i=0; i<iJoint; i++) {
        float3 dPos = Hash3(seed-iJoint+i)-0.5;
        //狙いボーンの位置に向かう
        float3 d = any(aimPos/EntireSize-p) ? normalize(aimPos/EntireSize-p) : float3(0,0,1);
        p += lerp(dir * 3 + dPos * 5 , d * 5 , iJoint ? Aim * i/iJoint : 0);
    }
    float3 dPos2 = Hash3(seed-iJoint+1300)-0.5;
    return  (p + dPos2 * iJoint * 0.5)*EntireSize;
}


//粒子の位置・速度の計算
//センターボーンによる回転・平行移動を加える前の座標で計算する
float2x3 ResolvePos(int iSparkle, int SparkleCount,out float phase, out bool valid)
{
    float iJoint = iSparkle % JOINTS;  //関節番号
    float iThunder = iSparkle-iJoint;
    valid = true;
    float t = int(Time*AnimSpeed*12) % 300;
    float3 rand = Hash3(iThunder);
    float birthT = rand.x;  //パーティクルの生まれた時刻
    float3 aimLocal;
    float3 dir = ResolveDirection(rand.yz, aimLocal);

    phase = iJoint/(JOINTS-1);

    if (InjectionBone.x < 0.01) {
        //出かかり
        valid =  iJoint/JOINTS < (10+InjectionBone.x)/10;
    } else if (InjectionBone.x > 0.01) {
        //出し切り
        valid = iJoint/JOINTS > InjectionBone.x/10;
    }

    float2x3 ret;
    if (iJoint == 0)
        ret[0] = 0;
    else
        ret[0] = JointPos(iJoint-1,dir,aimLocal, t + iThunder);
    ret[1] = JointPos(iJoint,dir,aimLocal, t + iThunder);

    return ret;
}


//注視してる点を入れるとU方向・V方向・法線を返す
float3x3 ComputeTBN(float3 dir, float3 pos)
{
    float3 B = dir;
    float3 v = /*ViewMatrix._13_23_33;//*/ normalize(pos - CameraPosition);
    float3 T = normalize(cross(v, B));
    float3 N = cross(T,B);
    return float3x3(T,B,N);
}


//パーティクルを書き込むパス
#ifdef YRZ_PASS_Main

VS_OUTPUT VS(uint index : SV_VertexID)
{
    VS_OUTPUT Out = (VS_OUTPUT)0;
	float4 Pos = 1e+5;

    if (index < Amount) {
        int iSparkle = index / 4;      //何個目の粒か
        int iVertex = index % 4;     //粒内の何個目の頂点か
        static int SparkleCount = Amount / 4; //表示対象の粒の総数
        float phase;
        bool valid;
        float2x3 ps = ResolvePos(iSparkle,SparkleCount,phase,valid);
        if (valid) {
            float3 p = mul(float4(ps[0],1),CenterMatrix);
            float3 head = mul(float4(ps[1],1),CenterMatrix);
            float3 v = head - p;
            float3x3 TBN = ::ComputeTBN(normalize(v),p+v*0.5);

            float2 uv = float2((iVertex/2+iVertex)%2,iVertex/2) - 0.5;
            float t = EntireSize * 0.5;//ResolveSize(iSparkle,phase);
            Pos = float4(p,1);
            Pos.xyz += uv.x * TBN[0] * t * Thickness * 10;
            Pos.xyz += (uv.y+0.5) * TBN[1] * length(v);

            Out.Pos = mul( Pos, ViewProjectionMatrix );
            Out.Eye = CameraPosition - Pos.xyz;
            Out.Tex = uv +0.5;
            Out.Color = float4(1,1,1, dstep01(0.1,0.7,phase) * Alpha);
            Out.Phase = phase;
        } else {
            Out.Pos = mul( Pos, ViewProjectionMatrix );
        }
    } else {
        Out.Pos = mul( Pos, ViewProjectionMatrix );
    }
    return Out;
}

//マスクを作成
float Maskin(float2 uv)
{
    float2 f = uv-0.5;
    float2 t = float2(abs(f.x*2) + (f.y > 0 ? f.y : 0),f.y);
    float c = smoothstep(0.5,0.25,length(t));  //楕円マスク
    return c;
}

float4 PS(VS_OUTPUT IN) : SV_Target
{
    float4 Color;
    float2 uv = IN.Tex;

    float3 texel = SparcleTexture.Sample(samp, uv).rgb;
    Color.rgb = pow(texel,Koshi) * Koshi * SparkleColor;  //ガンマ補正兼コントラスト処理
    float3 hsv = RGBtoHSV(Color.rgb);
    hsv.x = H;
    hsv.y = S;
    hsv.z *= V;
    Color.rgb = HSVtoRGB(hsv);

    Color.a = SoftParticle(IN) * IN.Color.a;

    return Color;
}

#endif
