[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
		"category" : "deform",
        "controllers": [
			{ "name":"C_SizePlus", "controllerName":"(self)", "item":"大きく", "type":"float" },
			{ "name":"C_SizeMinus", "controllerName":"(self)", "item":"小さく", "type":"float" },
			{ "name":"C_Rotate", "controllerName":"(self)", "item":"回転", "type":"float" },
			{ "name":"C_Gravity", "controllerName":"(self)", "item":"重力", "type":"float" },
			{ "name":"C_Center", "controllerName":"(self)", "item":"センター", "type":"float4x4" }
		],
        "passes": [ { "name":"Cracker", "type":"compute", "computeShader":"CS" } ]
    }
}
[HLSL]
#include "../hlsl/yrz.hlsli"
#include "../hlsl/resources_deform.hlsli"
using namespace YRZ;
using namespace Dayo;


//パーティクルを作るためのテンプレみたいなもの

static float Size = Exerp(1,10,C_SizePlus-C_SizeMinus);

YRZ_NUMTHREADS
void CS( uint3 id : SV_DispatchThreadID )
{
	uint idx = id.x;
	Vertex v = VB[idx];
	float ftime = Time;

	uint iSquare = idx / 4;
	uint iVertex = idx % 4;
	float2 uv = v.uv;

	float4 Xi = Hash4(iSquare);
	float t = frac(Xi.x + ftime) * 10;

	float c = lerp(-PI/6,PI/6, Xi.y * PI);
	float p = 2*Xi.z*PI;
	float3 V = {sin(c)*cos(p) , cos(c), sin(c)*sin(p)};
	V*=3;
	float3 G = float3(0,-1,0)*C_Gravity;
	float3 P = V*t + G*t*t/2;
	P = Transform(P,C_Center);
	
	P += (CameraRight * uv.x + CameraUp * uv.y ) * Size;

	v.normal = ViewMatrix._13_23_33;
	v.position = P;
	v.tangent = ViewMatrix._11_21_31;

    OutBuf[id.x] = v;
}

