[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
		"category" : "postprocess",
        "controllers": [
			{"name": "C_AlbedoR","controllerName": "(self)","item": "AlbedoR","type": "float", "slider":{"def":0.64} },
			{"name": "C_AlbedoG","controllerName": "(self)","item": "AlbedoG","type": "float", "slider":{"def":0.44} },
			{"name": "C_AlbedoB","controllerName": "(self)","item": "AlbedoB","type": "float", "slider":{"def":0.34} },
			{"name": "C_SigmaTR","controllerName": "(self)","item": "SigmaTR","type": "float", "slider":{"min":0.01, "max":10, "def":1.1} },
			{"name": "C_SigmaTG","controllerName": "(self)","item": "SigmaTG","type": "float", "slider":{"min":0.01, "max":10, "def":1.66} },
			{"name": "C_SigmaTB","controllerName": "(self)","item": "SigmaTB","type": "float", "slider":{"min":0.01, "max":10, "def":1.94} },

			{"name": "C_Ramp", "controllerName": "(self)","item": "Ramp","type": "float", "slider":{"def":0.2} },
			{"name": "C_CatR", "controllerName": "(self)","item": "CatR","type": "float", "slider":{"def":1.0} },
			{"name": "C_CatG", "controllerName": "(self)","item": "CatG","type": "float", "slider":{"def":0.1} },
			{"name": "C_CatB", "controllerName": "(self)","item": "CatB","type": "float", "slider":{"def":0.1} },
			{"name": "C_CatA", "controllerName": "(self)","item": "CatA","type": "float", "slider":{"max":0.1, "def":0.03} },

			{"name": "C_Roughness", "controllerName": "(self)","item": "Roughness","type": "float", "slider":{"def":1} },
			{"name": "C_IOR", "controllerName": "(self)","item": "IOR","type": "float", "slider":{"min":1, "max":2, "def":1.33} },
			{"name": "C_PowR", "controllerName": "(self)","item": "PowR","type": "float", "slider":{"max":5, "def":1} },
			{"name": "C_PowG", "controllerName": "(self)","item": "PowG","type": "float", "slider":{"max":5, "def":1} },
			{"name": "C_PowB", "controllerName": "(self)","item": "PowB","type": "float", "slider":{"max":5, "def":1} },

			{"name": "C_NormalScale", "controllerName": "(self)","item": "NormalScale","type": "float", "slider":{"max":10, "def":1} },
			{"name": "C_TextureLoops", "controllerName": "(self)","item": "TextureLoops","type": "float", "slider":{"max":100, "def":10} },
		],
		"textures": [
			{"name":"RampLUT", "size":{"absolute":true, "width":256, "height":256}, "format":"R16G16B16A16_FLOAT", "view":"RTV", "shared":"source"},
			{"name":"RampZH", "size":{"absolute":true, "width":256, "height":3}, "format":"R32G32B32A32_FLOAT", "view":"RTV", "shared":"source"},
			{"name":"RampSrc", "size":{"absolute":true, "width":256, "height":256}, "format":"R16G16B16A16_FLOAT", "view":"RTV"},
		],
		"buffers":[
			{"name":"ZHDebug", "size":{"absolute":true,"width":3}, "type":"float4", "view":"UAV"},
			{"name":"Fit", "size":{"absolute":true,"width":2}, "type":"float4", "view":"UAV"},
		],
		"samplers": [{ "name":"samp", "filter":"LINEAR", "addressU":"CLAMP", "addressV":"CLAMP" }],
        "passes": [
			{
				"name":"RampLUT", "type":"postprocess", "vertexShader":"VS", "pixelShader":"PS", "RTV":[{"name":"RampSrc"}],
				"outputSize":{"base":"RampSrc"}
			},
			{
				"name":"Normalize", "type":"postprocess", "vertexShader":"VS", "pixelShader":"PS", "RTV":[{"name":"RampLUT"}],
				"outputSize":{"base":"RampLUT"}
			},
			{
				"name":"RampZH", "type":"postprocess", "vertexShader":"VS", "pixelShader":"PS", "RTV":[{"name":"RampZH"}],
				"outputSize":{"base":"RampZH"}, "UAV":[{"name":"ZHDebug"}]
			},
			{"name":"Pass", "type":"postprocess", "vertexShader":"VS", "pixelShader":"PS"},
			{ "name":"Fit", "type":"compute", "computeShader":"CS",
				"outputSize":{"absolute":true, "width":1, "height":1}, "UAV":[{"name":"Fit"}], "numthreads":{"x":1}},
			{
				"name":"ZHDebug", "type":"compute", "computeShader":"CS",
				"outputSize":{"absolute":true, "width":1, "height":1}, "UAV":[{"name":"ZHDebug"}], "numthreads":{"x":1}
			}
		]
    }
}
[HLSL]
#include "../../../hlsl/resources_pp.hlsli"
#include "../../../hlsl/yrz.hlsli"
using namespace YRZ;
using namespace Dayo;



//toon用LUTを作る場合は有効に
//#define TOON

static float3 SigmaT = max(float3(C_SigmaTR,C_SigmaTG,C_SigmaTB) * 1000, 0.01);	//モーフ1 → σt=1[1/mm]
static float3 Albedo = float3(C_AlbedoR,C_AlbedoG,C_AlbedoB);

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.uv = uv;
	return vso;
}
//球面上の積分なので 2πr * R(r)を返す…でいいのかな？
float3 ChristensenBurley(float r)
{
    float3 s = 1.9 - Albedo + 3.5 * (Albedo - 0.8) * (Albedo - 0.8);
    s *= SigmaT;
    float3 D = (exp(-r * s) + exp(-r * s / 3)) * s / 4;	//∫D(r)dr, r=[0..∞]は1になる
	//float3 D = (exp(-r * s) + exp(-r * s / 3)) * s / (8*PI*r);	//本来のR(r)。r=0の時に∞に発散する
    return D;
}

inline float Gaussian(float v, float r)
{
    return 1.0f / sqrt(2.0f * PI * v) * exp(-(r * r) / (2.0f * v));
}

//こっちはr=0の時に∞に発散しない。やはり2πr * R(r)相当のカーブのような気がする
//実際∫Scatter(r)dr は1になる
float3 Scatter(float r)
{
    r *= 1000;  //mからmmに直す
    //文献より引用
    return
        float3(0.233f, 0.455f, 0.649f) * Gaussian(0.0064f * 1.414f, r)
        + float3(0.100f, 0.336f, 0.344f) * Gaussian(0.0484f * 1.414f, r)
        + float3(0.118f, 0.198f, 0.000f) * Gaussian(0.1870f * 1.414f, r)
        + float3(0.113f, 0.007f, 0.007f) * Gaussian(0.5670f * 1.414f, r)
        + float3(0.358f, 0.004f, 0.00001f) * Gaussian(1.9900f * 1.414f, r)
        + float3(0.078f, 0.00001f, 0.00001f) * Gaussian(7.4100f * 1.414f, r);
}

//curvature : 曲率[1/mm]
float3 Preintegrate(float mu, float curvature)
{
    float theta = acos(mu);
    int N = 1024;
    float3 tw = 0;
    float3 tc = 0;
    float R = 1E-3 / curvature;    //曲率半径[m]
    for (int i = 0; i < N; i++) {
        float x = ((i + 0.5) / N * 2 - 1) * PI;
        float r = 2 * R * abs(sin(x / 2));
        float3 w = ChristensenBurley(r);
		//float3 w = Scatter(r);
        tc += saturate(cos(theta + x)) * w;
        tw += w;
    }
	return tc/tw;
}

//正規化前のLUT作成
#ifdef YRZ_PASS_RampLUT
float4 PS(VSO vso) : SV_TARGET
{
	float mu,c;
	mu = (vso.uv.x*2)-1;
	c = vso.uv.y;

	#ifdef TOON
		//toon
		return float4(lerp(saturate(mu),smoothstep(1-c,-1+c,-mu), c).xxx,1);
	#else
		//preintegrate skin
		return float4(Preintegrate(mu,c),1);
	#endif
}
#endif

//正規化
#ifdef YRZ_PASS_Normalize
float4 PS(VSO vso) : SV_TARGET
{
	uint W,H;
	RampSrc.GetDimensions(W,H);
	float2 uv = vso.uv;

	float3 tc = 0;
	for (int i=0; i<W; i++) {
		tc += RampSrc.Sample(samp,float2((i+0.5)/W,uv.y)).rgb;
	}
	float3 avg = tc/W;
	//立体角4πに対し、投射立体角はπなので平均が1/4になるようにする
	float3 n = select(avg, RampSrc.Sample(samp,uv).rgb / avg, 0) * 0.25; 
	return float4(n,1);
}
#endif


//ZH
#ifdef YRZ_PASS_RampZH
float4 PS(VSO vso) : SV_TARGET
{
	uint W,H;
	RampLUT.GetDimensions(W,H);

	int l = vso.position.y;
	float3 ZH = 0;
	float v = vso.uv.x;
	for (int i=0; i<W; i++) {
		float u = (i+0.5)/W;
		float nz = u*2-1;
		float w = sqr(1-nz*nz);
		#ifdef TOON
			float3 r = lerp(saturate(nz),0.25, v);	//Toonの場合、見た目とは反対だがLambertian→無指向性で補完する
		#else
			float3 r = RampLUT.Sample(samp, float2(u,v)).rgb;
		#endif
		if (l==0) {
			ZH += 0.282095 * r * sqrt(4*PI);
		} else if (l==1) {
			ZH += 0.488603 * nz * r * sqrt(4*PI/3);
		} else {
			ZH += 0.315392 * (3*nz*nz-1) * r * sqrt(4*PI/5);
		}
	}

	ZH *= 4.0/W;

	return float4(ZH,1);
}
#endif

#ifdef YRZ_PASS_ZHDebug
[numthreads(1, 1, 1)]
void CS( uint3 id : SV_DispatchThreadID )
{
	int x = 128;
	ZHDebug[0] = RampZH[uint2(x,0)];
	ZHDebug[1] = RampZH[uint2(x,1)];
	ZHDebug[2] = RampZH[uint2(x,2)];
}
#endif



//exp(-s)によるフィッティングを行ってSSSSS用のパラメータを算出
//しかし、σtが分かっている場合は1/σtでいいのではなかろうか
#ifdef YRZ_PASS_Fit
[numthreads(1, 1, 1)]
void CS( uint3 id : SV_DispatchThreadID )
{
	const int N = 128;
	const float R = 0.1;	//計算する半径[m]
	
	//diffusion profile
	float3 Rr[N];
	for (int i=0; i<N; i++) {
		float r = (i+0.5) / N * R;
		//Rr[i] = Scatter(r)/r;
		Rr[i] = ChristensenBurley(r);
	}

    // t_i = x_i^2, y_i = ln(p[x_i])
    // y_i = ln A + m * t_i,  m = -1/(2*sigma^2)
    float3 sum_t  = 0;  // Σ t_i
    float3 sum_y  = 0;  // Σ y_i
    float3 sum_tt = 0;  // Σ t_i^2
    float3 sum_ty = 0;  // Σ t_i * y_i
	int3 M = 0;

    for(int i = 0; i < N; i++) {
		for (int c=0; c<3; c++) {
			float vx = Rr[i][c];
			if (vx <= 0) {
				continue;
			}
			float x = (i+0.5)/N*R;
			float t = x * x;
			float y = log(vx);
			sum_t[c]  += t;
			sum_y[c]  += y;
			sum_tt[c] += t * t;
			sum_ty[c] += t * y;
			M[c] ++;
		}
    }
    float3 denom = M * sum_tt - sum_t * sum_t;
    float3 m     = (M * sum_ty - sum_t * sum_y) / denom;
    float3 b     = (sum_y - m * sum_t) / M;

    // A = exp(b), sigma = sqrt(-1/(2 m))
    float3 A = exp(b);
    //float3 s = sqrt(-1.0 / (2.0 * m));	//ガウシアンフィッティングの場合はこっち
	
	//expでフィッティングした場合
	float3 s = -m;
	Fit[0] = float4(1000/s,0.01);
	
	//Fit[1] = float4(1000/SigmaT,1);	//単純にmfp[mm]

	//Christensen-Burleyの最初の項だけを抜き出した場合
	float3 S = 1.9 - Albedo + 3.5 * (Albedo - 0.8) * (Albedo - 0.8);
	Fit[1] = float4(1000/(S*SigmaT),0.01);	

}
#endif

#ifdef YRZ_PASS_Pass
float4 PS(VSO vso) : SV_TARGET
{
	float4 c = ScreenTexture.Sample(samp,vso.uv);
	float2 pix = vso.position.xy;
	if (all(pix == clamp(pix,0,255)))
		c.rgb = RampLUT.Sample(samp,pix/256.0).rgb;
	/*
	else if (pix.y <= 255 && pix.x > 255 && pix.x<512) {
		float2 p = (pix - float2(255,0))/256.0;
		float r = length((p-0.5)*2) * 0.01;	//表示範囲[m]
		//c.rgb = Scatter(r)/(2*PI*r);
		c.rgb = ChristensenBurley(r)/(2*PI*r);
	}
	*/
	return c;
}
#endif