[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
		"category" : "render",
        "controllers": [{"name": "dayobj","controllerName": "(self)","item": "Tr","type": "float"}],
        "passes": [ {"name":"BarPass", "type":"postprocess", "pixelShader": "PS", "vertexShader": "VS"} ]
    }
}
[HLSL]

#include "../hlsl/resources.hlsli"
using namespace Dayo;

struct VSO {
	float4 position:SV_POSITION;
	float2 uv:TEXCOORD;
};

VSO VS( float4 pos : POSITION, float2 uv:TEXCOORD )
{
	VSO vso = (VSO)0;
	vso.position = pos;
	vso.position.w = 1;
	vso.uv = uv;
	return vso;
}

float4 PS(VSO vso) : SV_TARGET
{
	float3 o = 0;
	float2 uv = vso.position.xy / Resolution;

	if (uv.y < 0.66) {
		int idx = 7-floor(uv.x*7);
		int bit2 = idx >> 2;
		int bit1 = (idx >> 1) & 1;
		int bit0 = idx & 1;
		o = float3(bit2,bit1,bit0) * 0.5;
	} else if (uv.y < 0.743) {
		int idx = floor(uv.x*7);
		if (idx == 0) {
			o = float3(0,0,1);
		} else if (idx == 4) {
			o = float3(1,0,1);
		} else if (idx == 2) {
			o = float3(0,1,1);
		} else if (idx == 6) {
			o = 1;
		}
		o *= 0.5;
	} else {
		int idx = floor(uv.x*18);
		if (idx < 3) {
			o = float3(0,0,0.1);
		} else if (idx < 6) {
			o = 1;
		} else if (idx < 9) {
			o = float3(0.05,0,0.1);
		} else if (idx < 12) {
			o = float3(0.02,0.02,0.02);
		} else if(idx < 13) {
			o = 0;
		} else if (idx < 14) {
			o = float3(0.02,0.02,0.02);
		} else if (idx < 15) {
			o = float3(0.04,0.04,0.04);
		} else {
			o = float3(0.02,0.02,0.02);
		}
	}

	RTOutput[trunc(vso.position.xy)] = float4(o, 1);
	discard;
	return 0;
}
