[YRZFX]
{
    "fx": {
        "cereal_class_version": 0,
		"category" : "render",
		"memos" : [ "SkyboxSampler" ],
        "controllers": [
			{ "name": "C_Is", "controllerName": "dayorencon.pmx", "type":"bool"},
			{"name": "C_Aperture","controllerName": "dayorencon.pmx","item": "開口","type": "float",
				"desc":["The out-of-focus areas will become blurred","ピントの合っていない場所がボケるようになります"] },
			{"name": "C_Diffusion","controllerName": "dayorencon.pmx","item": "拡散","type": "float",
				"desc":["Apply a diffusion filter effect","ディフュージョンフィルタの効果を付けます"] },
			{"name": "C_Devignette", "controllerName": "dayorencon.pmx","item": "周辺減光補正","type": "float", 
				"desc":["Reduces the lens-induced darkening effect at the edges of the screen","画面端ほど暗くなるレンズ由来の効果を抑えます"] },
			{"name": "C_ExposurePlus","controllerName": "dayorencon.pmx","item": "露出+","type": "float", 
				"desc":["Brighten the screen","画面を明るくします"]},
			{"name": "C_ExposureMinus","controllerName": "dayorencon.pmx","item": "露出-","type": "float", 
				"desc":["Dim the screen","画面を暗くします"]},
			{"name": "C_SkyboxRotate","controllerName": "dayorencon.pmx","item": "skybox回転","type": "float"},
			{"name": "C_Pint","controllerName": "dayorencon.pmx","item": "ピント","type": "float3", 
				"desc":["","このボーンのある位置にピントが合います"] },
			{"name": "C_AL","controllerName": "dayorencon.pmx","item": "AL発光","type": "float", 
				"desc":["","AutoLuminous対応材質が発光するようになります"] },
			{"name": "C_MaxBounce", "controllerName": "dayorencon.pmx","item": "バウンス数","type": "float",
				"slider":{"int":true, "def":2, "min":1, "max":30},
				"desc":["Specifies how many reflections to handle","何回までの反射を取り扱うかを指定します"] },
			{ "name": "C_Spectral", "controllerName": "dayorencon.pmx","item": "分光","type": "float",
				"slider":{"int":true },
				"desc":["Rendering takes into account the spectrum. Light passing through glass creates a rainbow.",
					"分光を考慮したレンダリングをします。ガラスを透過した光が虹を作るようになります"] },

			{"name": "V_DensePlus[8]", "controllerName": "dayovolbox.pmx", "item":"濃く", "type":"float"},
			{"name": "V_DenseMinus[8]", "controllerName": "dayovolbox.pmx", "item":"薄く", "type":"float"},
			{"name": "V_ID[8]", "controllerName": "dayovolbox.pmx", "item":"", "type":"int"},
			{"name": "V_Texture[8]", "controllerName": "dayovolbox.pmx", "item":"テクスチャ", "type":"float",
				"desc":["Enable texture","テクスチャを有効にします"] },
			{"name": "V_Light[8]", "controllerName": "dayovolbox.pmx", "item":"発光", "type":"float"},
			{"name": "V_TempPlus[8]", "controllerName": "dayovolbox.pmx", "item":"発光温度+", "type":"float"},
			{"name": "V_TempMinus[8]", "controllerName": "dayovolbox.pmx", "item":"発光温度-", "type":"float"},
			{"name": "V_Frame[8]", "controllerName": "dayovolbox.pmx", "item":"コマ", "type":"float3", 
				"desc":["For animated textures, the integer part of the x coordinate of this bone determines the frame to be displayed.",
				"アニメーションテクスチャの場合、このボーンのx座標の整数部で表示されるフレームを決めます"] },
			{"name": "V_TexRot[8]", "controllerName": "dayovolbox.pmx", "item":"テクスチャ回転", "type":"float4x4"},

			{"name": "V_H[8]", "controllerName": "dayovolbox.pmx", "item":"色相", "type":"float"},
			{"name": "V_S[8]", "controllerName": "dayovolbox.pmx", "item":"彩度", "type":"float"},
			{"name": "V_V[8]", "controllerName": "dayovolbox.pmx", "item":"明るさ", "type":"float", 
				"desc":["Specifies the reflectivity of the medium. The higher the reflectivity, the brighter it is, and the lower the absorptivity. A medium with low absorptivity does not emit light.",
				"媒質の反射率を指定します。反射率が高いほど明るく、吸収率は低くなります。吸収率の低い媒質は発光しません"] },
			{"name": "V_Show[8]", "controllerName": "dayovolbox.pmx", "item":"", "type":"bool"}
		],
		"samplers" : [
			{ "name":"samp" },
			{ "name":"LinearSamp", "filter":"linear" },
			{ "name":"BorderSamp", "filter":"linear",  "addressU":"border", "addressV":"border", "addressW":"border", "borderColor":"OPAQUE_BLACK" }
		],
		"textures" : [
			{ "name":"Aperture", "filename":"BDPT/r/aperture.png"},
			{ "name":"CurrentFrame", "format":"R32G32B32A32_FLOAT", "view":"UAV" },
			{ "name":"TempLUT", "filename":"BDPT/r/StefanBoltzmann.dds"}
		],
		"buffers" : [
			{ "name": "MatLights", "type":"float4", "elemSize":16, "size":{"base":"TOTALMATERIALCOUNT"}, "view":"UAV" },
			{ "name": "Mat2Light", "type":"uint", "elemSize":4, "size":{"base":"TOTALMATERIALCOUNT"}, "view":"UAV" },
			{ "name": "MatLightCounter", "type":"uint", "elemSize":4, "size":{"absolute":true, "width":1}, "view":"UAV" }
		],
        "passes": [
			{ "name":"Clear", "type":"clearUAV", "target":"CurrentFrame", "value":{"x":0, "y":0, "z":0, "w":0} },
			{
				"name":"MatLight", "type":"raytracing", "raygenShader": "MatLight",
				"UAV":[ {"name":"MatLights"}, {"name":"MatLightCounter"}, {"name":"Mat2Light"}],
				"outputSize":{"absolute":true, "width":1, "height":1, "depth":1, "dimension":1}
			},
			{
				"name":"BDPT", "type":"raytracing",
				"raygenShader": "RayGeneration",
                "missShader": [ "Miss", "MissSSS", "MissShadow" ],
                "hitGroup": [
                    { "type":"TRIANGLES", "closestHit": "ClosestHit", "anyHit": "AnyHit", "intersection": "" },
                    { "type":"TRIANGLES", "closestHit": "ClosestHitSSS", "anyHit": "AnyHitSSS", "intersection": "" },
                    { "type":"TRIANGLES", "closestHit": "ClosestHitShadow", "anyHit": "AnyHitShadow", "intersection": "" }
                ],
                "callableShader": [],
                "maxPayloadSize": 128, "maxAttributeSize": 8, "maxRecursionDepth": 4,
				"UAV":[{"name":"CurrentFrame"}]
			},
			{ "name":"Acc", "type":"raytracing", "raygenShader":"Acc" , "UAV":[{"name":"CurrentFrame"}]},
			{
				"name":"GBuffer", "type":"raytracing",
				"raygenShader": "RayGenOIDN",
                "missShader": [ "MissOIDN" ],
                "hitGroup": [
                    { "type": "TRIANGLES", "closestHit": "ClosestHitOIDN", "anyHit": "AnyHitOIDN", "intersection": "" }
                ],
                "callableShader": [],
                "maxPayloadSize": 128, "maxAttributeSize": 8, "maxRecursionDepth": 2
			}
		],
        "matDescs": {
            "name": "PBR",
            "template": "BDPT/m/_template.txt",
            "defaultFile": "BDPT/m/default.txt"
        }
    }
}
[HLSL]
/* bidirectional pathtracer版 */

/***************************************************************************
	定数
****************************************************************************/
//最大最大探索回数(想定するMaxBounceの最大値)
#define MAX_DEPTH 32
static float SkyRadius = 1e+5;	//skyboxの仮想半径
static float CLAMP_L = 1e+3;	//ファイアフライ対策用1サンプルの最大輝度

/***************************************************************************
	コントローラ由来の変数
****************************************************************************/
static int MaxBounce = C_Is ? clamp(C_MaxBounce+2,3,32) : 4;
static bool SpectralRendering = C_Spectral >= 0.5;


#ifdef __INTELLISENSE__
cbuffer YRZFX_ControllerCB : register(b1) {
    float C_Aperture;
    float C_Diffusion;
    float C_Devignette;
    float C_ExposurePlus;
    float C_ExposureMinus;
    float C_SkyboxRotate;
    float3 C_Pint;
    float C_AL;
    float V_DensePlus[8];
    float V_DenseMinus[8];
    int V_ID[8];
    float V_Texture[8];
    float V_Light[8];
    float V_TempPlus[8];
    float V_TempMinus[8];
    float3 V_Frame[8];
    float4x4 V_TexRot[8];
    float V_H[8];
    float V_S[8];
    float V_V[8];
    bool V_Show[8];
};
#endif

#include "BDPT/hlsl/PMXUtils.hlsli"

static float Exposure = exp2((C_ExposurePlus - C_ExposureMinus)*10);
static float SkyboxPhi = C_SkyboxRotate;
static float LensR = max(0.001,C_Aperture);
static float Pint = max(0.1,length(C_Pint - CameraPosition));
static float Devignette = sqr(saturate(C_Devignette));

//VREの計算の前提として、σs+σa = σt = 1とする。σsはsingle scattering albedoに等しい
//σt≠1になるようなボリュームに対して所望の見た目を得るには密度の方を調整する
//透過率に波長依存性のある媒質は扱わない

#define NUM_VOLBOX 8
static int nVolBox = (V_ID[0]>=0) + (V_ID[1]>=0) + (V_ID[2]>=0) + (V_ID[3]>=0) + (V_ID[4]>=0) + (V_ID[5]>=0) + (V_ID[6]>=0) + (V_ID[7]>=0);
static float pVolsel = nVolBox ? 1.0/nVolBox : 1;	//各ボルボックスの選択確率
static float VolG = 0.5;	//前方散乱係数
static int MaxVolScatter = 16;	//ボリューム内での最大散乱回数

//σs/σt
float3 VolAlbedo(int i)
{
	return saturate(HSVtoRGB(float3(V_H[i],V_S[i],V_V[i])));
}

//σa
float3 VolSigmaA(int i)
{
	return 1-VolAlbedo(i);
}

float VolTemp(int i)
{
	return Exerp(1,10,V_TempPlus[i]-V_TempMinus[i]);
}

//濃度
float VolDens(int i)
{
	float plus = V_DensePlus[i];
	float minus = V_DenseMinus[i];
	float a = plus-minus;
	return a <=-1 ? 0 : Exerp(1e-3,1,a);
}

//ボリューム全体が白色光を発する気体だった場合の体積当たりの光束
float VolLight(int i)
{
	float x = V_Light[i];
	return x ?  Exerp(4*PI*1e-3,4*PI*1e+3,x) : 0;
}


//発光体の推定平均充填率(VBLight * 体積 * VolLightRate ≒ 全光束としてボルボックスが発光体としてサンプルされるpdfを出すための値)
static float VolLightRate = 0.05;

//deta/ratio trackingの打ち切り回数
#define MAX_VOL_TRACKING 256

//ボルボックスの範囲を取得
bool VolBoxAABB(int iVol, out float3 AA, out float3 BB)
{
	AA = -1e+6; BB = -1e+6;
	if (iVol < 0) {  return false; }		//iVolが無効
	if (!V_Show[iVol]) { return false; }	//非表示状態
	AA = VB[V_ID[iVol]][6].position;	//小さい方の隅
	BB = VB[V_ID[iVol]][0].position;	//大きい方の隅
	return true;
}

//各ボルボックスの光束を求める
float VBFlux(int idx)
{
	float3 AA,BB;
	if (VolBoxAABB(idx, AA,BB)) {
		float3 b = BB-AA;
		float v = b.x*b.y*b.z;	//体積
		return v * VolLight(idx) * VolLightRate;
	} else {
		return 0;
	}
}

static float VolFlux[NUM_VOLBOX] = {VBFlux(0), VBFlux(1), VBFlux(2),VBFlux(3),VBFlux(4),VBFlux(5),VBFlux(6),VBFlux(7) };
static float TotalVolFlux = VolFlux[0] + VolFlux[1] + VolFlux[2] + VolFlux[3] + VolFlux[4] + VolFlux[5] + VolFlux[6] + VolFlux[7];



#include "BDPT/hlsl/common.hlsli"


#ifdef YRZ_PASS_MatLight
[shader("raygeneration")]
//[numthreads(1,1,1)]
//多少ともemissionを持っている材質を「光源材質」と呼ぶ(RestrictedLightを除く)
//光源材質を列挙して光源材質配列を作り、光源材質配列内で光束に比例したサンプリングが行えるようにする
void MatLight()//(uint3 id : SV_DispatchThreadID)
{
	//全モデル内での材質番号を総材質番号と呼ぶ(例:モデル#0の材質数が20なら、モデル#1の材質番号3 = 総材質番号23)
	//uint Mat2Light[m] : 総材質番号→光源材質番号テーブル
	//float4 MatLights[idx] : {材質の光束,pdf,cdf,総材質番号}, idxは光源材質番号

	uint nMats = TotalMaterialCount;
	uint nModels = ModelCount;
	float totalFlux = 0;	//シーン内の光源ポリゴンによる全光束

	//まず配列のクリア 配列には最低1の幅があるので「本当は0だけど1」の事を考える
	for (int j=0; j<max(1,nMats); j++) {
		MatLights[j] = float4(0,0,0,0);
		Mat2Light[j] = -1;
	}

	//各光束と全光束の計算
	uint idx=0;	//総材質中のインデックス
	uint iWrite = 0;	//テーブル内の書き込み位置
	for (uint imo = 0; imo < nModels; imo++) {
		uint mcount = Model2Mat[imo].y;
		if (Peekaboo[imo]) {	//非表示モデルの場合は飛ばす
			for (uint imat = 0; imat < mcount; imat++) {
				Material m = GetMaterial(imo, imat);
				float flux = 0;
				if (!m.restrictedLight)	//RestrictedLightフラグが立っている場合はサンプリングされずs=0パスでのみ現れる光源
					flux = RGBtoY(m.emission) * PI * ((1-sqr(m.lightCosFalloff)) + (1-sqr(m.lightCosHotspot))) * Mat2face[imo][imat].totalArea;
				if (!m.twosided)
					flux /= 2;
				if (flux > 1e-10) {
					Mat2Light[idx] = iWrite;
					totalFlux += flux;
					MatLights[iWrite].x = flux;	//xに注目材質の光束
					MatLights[iWrite].w = idx;	//wに注目材質の番号
					iWrite++;
				} else {
					Mat2Light[idx] = -1;
				}
				idx++;
			}
		} else {
			idx += mcount;
		}
	}

	MatLightCounter[0] = iWrite;

	//y:pdfとz:cdfの計算
	MatLights[0].y = totalFlux ? MatLights[0].x/totalFlux : 0;
	MatLights[0].z = MatLights[0].y;
	if (iWrite <= 1)
		return;

	for (uint i=1; i<iWrite; i++) {
		MatLights[i].y = totalFlux ? MatLights[i].x / totalFlux : 0;
		MatLights[i].z = MatLights[i].y + MatLights[i-1].z;
	}

}
#endif


#ifdef YRZ_PASS_BDPT
#include "BDPT/hlsl/PMXLight.hlsli"
#include "BDPT/hlsl/PMXBxDF.hlsli"

//#include "LensSystem.hlsl"
//#include "RandomWalkSSS.hlsl"

/***************************************************************************
	参考文献

Eric Veach氏 "Robust Monte Carlo Methods for Light Transport Simulation"
https://graphics.stanford.edu/papers/veach_thesis/

pbrt "16.3 Bidirectional Path Tracing"
https://pbr-book.org/3ed-2018/Light_Transport_III_Bidirectional_Methods/Bidirectional_Path_Tracing

Wenzel Jakob氏 "LIGHT TRANSPORT ON PATH-SPACE MANIFOLDS"
https://ecommons.cornell.edu/items/88edcaca-ebc6-4ad5-91bd-7a72539c3ddd

Jan Novák氏ほか "Monte Carlo methods for physically based volume rendering" In ACM SIGGRAPH Courses, 2018
https://cs.dartmouth.edu/~wjarosz/publications/novak18monte-sig.html

****************************************************************************/


/***************************************************************************
	構造体
****************************************************************************/
//散乱イベント, Veach論文での頂点y[i],z[i]に対応
//コメントでx[i]と書いたらyでもzでもどっちでもいい頂点を指す
struct Event {
	float3 beta;	//論文でのαi+1LまたはEに対応 i+1 である点に注意
	float PG;		//pdf[1/sr] * G(i-1→i) 前の頂点から自分がサンプルされるpdf[1/m²]
	float PGrev;	//pdf[1/sr] * G(i+1→i) 後の頂点から自分がサンプルされるpdf[1/m²]
	float3 P;		//位置
	float3x3 TBN;	//接空間(0:Tangent 1:Binormal, 2:Normal)(法線マップ・スムージング込み)
	float3 Ng;		//ポリゴン自体の法線(法線マップ・スムージング抜き)
	bool S;			//完全鏡面反射・透過フラグ
	bool sky;		//skyboxのどこかですフラグ
	float etaI,etaO;//入射前後の媒質屈折率
	Material m;		//マテリアル
	int iFace;		//面番号
	int iModel;		//モデル番号
	float rusQ;		//ロシアンルーレットによるPDFへの倍率
	bool SSSOut;	//表面下散乱の出口パッチであるフラグ
	bool SSSIn;		//表面下散乱の入口パッチであるフラグ
	float3 muT;		//直前の頂点からこの頂点の間の媒質の消散率(ガラスの中に通ってたら1未満になり得る)[1/MMD]
	bool surface;	//散乱イベントは物体の表面か？
};

/***************************************************************************
	Miss, CHS, AnyHyit, Intersectionシェーダ
****************************************************************************/
[shader("miss")]
void Miss(inout Payload payload)
{
	payload.miss = true;
}

[shader("closesthit")]
void ClosestHit(inout Payload payload, Attribute attr)
{
	payload.ID = InstanceID();
	payload.miss = false;	//BDPTでは大事(ライトサブパスとカメラサブパスを作るので、フラグを消さないと片方のサブパスが作られ無くなる)
	payload.iFace = PrimitiveIndex();
	payload.uv = attr.st;
	payload.t = RayTCurrent();
}

[shader("anyhit")]
//ハマった話…AnyHitShaderは始点から近く→遠くの順に起動される保証はないとのこと
void AnyHit(inout Payload payload, Attribute attr)
{
	uint id = InstanceID();
	uint triangleIndex = PrimitiveIndex();
	Material m = GetMaterialBary(id, triangleIndex, attr);
	float face = -dot(normalize(WorldRayDirection()),GeometryNormal(id, PrimitiveIndex()));

	if (m.category != CAT_GLASS) {
		//ガラス以外の場合、αに応じて透過・不透過の選択
		if ( (m.alpha < RNG.x) && (m.alpha<0.98))
			IgnoreHit();
		if (face<0 && !m.twosided)
			IgnoreHit();
	}
	//ガラスの場合、αや面の向きによらずヒットしたとみなす
}

/* fog版BRDFサンプリング用シェーダ…
　現在はボルボックスとのソフトウェア当たり判定で行っているので未使用
　将来intersection shaderを使うようになった時のために跡だけ残しておく */
[shader("closesthit")]
void ClosestHitFog(inout Payload payload, Attribute attr)
{
	payload.t = RayTCurrent();
	payload.ID = InstanceID();
	payload.iFace = -1;
}

[shader("intersection")]
void IntersectFog()
{
	//とりあえずフォグは後回し
	return;

	Attribute attr = (Attribute)0;
	float3 rd = normalize(WorldRayDirection());
	float3 P = WorldRayOrigin() + RayTCurrent() * rd;

	float4 Xi = Hash4(uint4(DispatchRaysIndex().xy, iSample, 0) + uint4(0,P*1000));
	float d = -log(1-Xi.x) * 100;
	ReportHit(d, 0, attr);
}


/***************************************************************************
	ユーティリティ関数
****************************************************************************/

//アニメーションを考慮した場合のAA-BBにマップされるuvw座標
void VolTexCoord(int iVol, out float3 uvwA, out float3 uvwB)
{
	uint4 frames = GetPBRValue(V_ID[iVol], 0).VolumeDiv;
	
	if (all(frames.xyz<=1)) {
		//アニメなし版
		uvwA = 0;
		uvwB = 1;
		return;
	}

	//アニメあり
	int nU = frames.x;
	int nV = frames.y;
	int nW = frames.z;	//UVWを何コマに切っているか
	int k = trunc(abs(V_Frame[iVol].x)) % (frames.w);	//何コマ目か
	int iU = k%nU;
	int iW = k/(nU*nV);
	int iV = (k % (nU*nV)) / nU;

	uvwA = float3(iU,iV,iW) / float3(nU,nV,nW);
	uvwB = (float3(iU,iV,iW)+1) / float3(nU,nV,nW);
}

//位置Pのボリュームデータを得る。xに密度、yに温度が入る
//この値*ボルボックスで定義される密度で実際の密度になる
//密度は0～1でなければならない
//※Pがボルボックスに含まれているかのチェックは呼び出し元で既に行われていると仮定する
float2 VolFetch(int iVol, float3 P)
{
	if (V_Texture[iVol]) {
		float3 AA,BB;
		VolBoxAABB(iVol,AA,BB);

		float4 t = {1,0,0,1};
		PBRTexture3D p3d = GetPBRTexture3D(V_ID[iVol],0);
		if (p3d.hasVolumeMap) {
			//まずワールド座標→ボルボックス座標に変換
			float3 uvw = frac((P-AA)/(BB-AA));
			
			//a,b:アニメーションの現在のコマに対応する切り出し範囲
			float3 a,b;
			VolTexCoord(iVol,a,b);
			
			//テクスチャ座標の回転
			float3x3 m;
			//なんでかV_TexRot[iVol]だとテクスチャ座標?がぶっ壊れる。V_TexRot[0]とかだとOK
			//↑というような事があってかなりハマった、現在はなぜか治っている
			/*
			if (iVol==0)
				m = (float3x3)V_TexRot[0];
			else
				m = (float3x3)V_TexRot[1];
			*/
			m = (float3x3)V_TexRot[iVol];
			uvw = saturate(mul(m, uvw-0.5) + 0.5);

			//テクスチャ座標のループ
			PBRValue pbr = GetPBRValue(V_ID[iVol],0);
			uvw = uvw*pbr.VolumeLoops;

			//テクスチャの内容を取得
			if (pbr.VolumeWrap==0 && any(uvw!=saturate(uvw)))
				t = 0;
			else {
				uvw = lerp(a,b,frac(uvw));
				t = p3d.VolumeMap.SampleLevel(LinearSamp, uvw, 0);
			}
		}
		return t.rg;
	} else {
		return float2(1,0);
	}
}

//ボリュームに書いてある温度 → 単位長さ当たりの寄与を計算する
//TODO : Stephan-Boltzmannカーブに当てはめて色を補正
float3 TempLe(int iVol, float t)
{
	return TempLUT.SampleLevel(LinearSamp, float2(saturate(t*VolTemp(iVol)),0.5), 0).rgb;
}

//PにおけるボルボックスiVolによる単位長さ当たりの寄与
float3 VolLe0(int iVol, float3 P)
{
	float t = VolFetch(iVol, P).y;	//温度
	return TempLe(iVol,t) * VolDens(iVol) * VolLight(iVol) * VolSigmaA(iVol);
}

//ボリュームの場合の配光特性(1/4*PI)で一定
float VolLe1()
{
	return 1/(4*PI);
}

//ボリューム内での走行距離を求める(ボルボックス1個分)
//roはAABBの入口、tmaxはAABBとの交点の長さ
float SampleVolDist1(inout Payload payload, int iVol, float3 ro, float3 rd, float tmax)
{
	float d = 0;
	if (V_Texture[iVol]) {
		for (int i=0; i<MAX_VOL_TRACKING; i++) {
			d += SampleFreePath(VolDens(iVol), RNG.x);
			if (d > tmax)
				break;
			float v = VolFetch(iVol, ro+rd*d).r;
			if (RNG.x < v)
				break;
		}
	} else {
		d = SampleFreePath(VolDens(iVol), RNG.x);
	}
	return d;
}


//sからeまでボリューム内を通過した時に発光分によって得られる寄与、ボルボックス1つ分
float3 SampleVolEmission(inout Payload payload, int iVol, float3 s, float3 e)
{
	if (VolDens(iVol) == 0 || VolLight(iVol) == 0)
		return 0;

	//そもそも交差してなければ0
	float3 AA,BB;
	VolBoxAABB(iVol,AA,BB);
	float t0,t1;
	if (!SegAABB(s,e,AA,BB,t0,t1))
		return 0;
	
	float3 rd = normalize(e-s);
	float3 ro = s + rd * t0;

	float y = SampleVolDist1(payload, iVol, ro,rd, t1-t0);

	//https://cs.dartmouth.edu/~wjarosz/publications/novak18monte-sig-slides-3-distance-sampling-notes.pdf
	//"MATHEMATICAL FORMALIZATION" の項より
	//所望の値 <L(x,ω)> = [T(s,e)/p(y) * μa Le(y)]
	//yをサンプルするpdf : p(y) = μt*T(s,e)
	//yに基づいて得た値 L = μa Le(y)
	//∴ <L(x,ω)> = L/μt
	float3 L = VolLe0(iVol, ro + y*rd) * VolLe1();
	return L / VolDens(iVol);
}

//始点sから終点eまでのボリューム内の透過率T(s,e)と寄与を求める(ボルボックス1個分)
float VolTr1(inout Payload payload, int iVol, float3 s, float3 e)
{
	float3 AA,BB;
	VolBoxAABB(iVol, AA,BB);
	float t0,t1;
	if (!SegAABB(e,s,AA,BB, t0,t1))
		return 1;

	float3 ro = s;
	float3 rd = normalize(e-s);
	
	float tr = 1;
	if (V_Texture[iVol]) {
		float d = t0;
		for (int i=0; i<MAX_VOL_TRACKING; i++) {
			d += SampleFreePath(VolDens(iVol), RNG.x);
			if (d > t1)
				break;
			float v = VolFetch(iVol, ro+rd*d).r;
			tr *= 1-v;
		}
	} else {
		tr = exp(-VolDens(iVol)*(t1-t0));
	}

	return tr;
}


//可視判定抜きの幾何項
//xとyはどっちがどっちでも同じ値が返る
//gxとgyはx,yについてコサイン項を考慮するならtrue
//skyをtrueにすると、無限遠光源との接続という事で距離項を加味しない
float GeometryTerm(float3 x, float3 y, float3 Nx, float3 Ny, bool gx, bool gy, bool sky)
{
	float3 D = x-y;
	float3 w = normalize(D);
	
	float d2 = sky ? 1 : dot(D,D);
	float wox = gx ? abs(dot(w,Nx)) : 1;
	float woy = gy ? abs(dot(w,Ny)) : 1;

	return abs( wox * woy / max(1e-10,d2));
}

//コネクト時の可視項
//y:光源側頂点
//z:カメラ側頂点
//sideCheck : 光源の裏表のチェック、yがy0の時はtrue ... 現在はLightLe1でやっているので不要かも
float3 VisibilityTerm(inout Payload payload, Event y, Event z,bool sideCheck)
{
	float d;
	float3 L = LenDir(y.P-z.P, d);	//パッチ→光源

	//ライトポリゴンが片面材質の場合はライト法線の方から見えるのかチェック
	if (sideCheck && (dot(L, y.TBN[2])>0) && !y.m.twosided && !y.sky)
		return 0;

	//ライトポリゴンが遮られていないかテスト
	RayDesc shadowDesc;
	shadowDesc.Origin = z.P;	//zの表面からyに向けて粗く撃つ
	shadowDesc.Direction = L;
	float eps = max(1e-3, d * 1e-3);
	shadowDesc.TMin = eps;
	shadowDesc.TMax = d-eps;
	PayloadShadow payshadow;
	payshadow.xi = floor(RNG.x * 0x7FFFFFFF);
	payshadow.Tr = 1; 
	TraceRay(TLAS, RAY_FLAG_NONE, 0xFF, 2,0,2, shadowDesc, payshadow);

	if (any(payshadow.Tr != 1))
		return payshadow.Tr;
	
	//リーク対策、epsが大きい場合は近場からもう一回撃つ(z.Pの表面から短い範囲に正確に撃つ)
	if (eps > 0.01) {
		shadowDesc.TMin = 1e-3;
		shadowDesc.TMax = d - 1e-3;
		payshadow.Tr = 1;
		payshadow.xi = floor(RNG.x * 0x7FFFFFFF);
		TraceRay(TLAS, RAY_FLAG_NONE, 0xFF, 2,0,2, shadowDesc, payshadow);
	}
	return payshadow.Tr;
}


//Pσ(e→ne)をPA(e→ne)にする
float ConvertPDF(float pdf, Event e, Event ne)
{
	float3 v = ne.P - e.P;
	float3 w = normalize(v);
	float d2 = dot(v,v);
	float3 N = ne.TBN[2];

	if (ne.sky)
		return pdf;
	if (e.sky)
		return pdf * abs(dot(N, w));	//1029朝追加
	if (!e.surface)
		return pdf / d2;	//2025-0311追加

	return pdf * abs(dot(N, w)) / d2;	//e.N・wが無いのは pσ(e→ne) = pσ⊥(e→ne)|e.N・w|だからpdfに含まれている
}

//↓のボリューム拡張用、x1が与えられてボリューム内のx2の位置(距離)をサンプルするpdf(測度は長さ)
float VolumeLengthPDF(inout Payload payload, Event x1, Event x2)
{
	float3 ro = x1.P;
	float3 rd = normalize(x2.P-x1.P);
	float pdf = 0;
	for (int i=0; i<nVolBox; i++) {
		//pdf = mu(x2) * transmittance(x1→x2)
		//2つ以上のボリューム内でサンプルされる可能性がある場合、より大きい方ということにしとく
		float tr = VolTr1(payload, i, x1.P,x2.P);
		float mu = VolFetch(i, x2.P).x * VolDens(i);
		pdf = max(pdf, tr * mu);
	}
	return pdf;
}

//x0→x1→x2にレイが飛ぶ確率密度(測度は x2が表面なら面積、ボリュームなら体積) Pσ⊥(x1→x2)G(x0→x1→x2)
float PG(inout Payload payload, int waveCh, Event x0, Event x1, Event x2, bool forward)
{
	if (x1.S)
		return 0;

	float3 wi = normalize(x0.P-x1.P);
	float3 wo = normalize(x2.P-x1.P);

	float pdf;
	if (x1.surface) {
		float3 N = x1.TBN[2];
		float3x3 TBN;
		if (dot(x1.Ng, wi) > 0) {
			TBN = x1.TBN;
		} else {
			TBN = -x1.TBN;
		}
		pdf = BxDFPDF(waveCh, x1.m, TBN, wi, x1.etaI, wo, x1.etaO, x1.SSSIn, x1.SSSOut) * x1.rusQ;
	} else {
		pdf = HenyeyGreenstein(-dot(wi,wo), VolG);
	}

	pdf = ConvertPDF(pdf, x1, x2);
	if (!x2.surface) {
		//↑までで求めた面積当たりのpdfに長さ当たりのpdfを掛けて体積当たりのpdfにする
		pdf *=  VolumeLengthPDF(payload, x1,x2);
	}

	return pdf;
}


//0だったら1にするだけの関数。S頂点のpdf計算をスルーさせるための関数
float Remap0(float x)
{
	if (x==0)
		return 1;
	return x;
}

//シェーディング法線使用の際にadjoint BSDFを補正する関数
float CorrectShadingNormal(float3 N, float3 Ng, float3 wi, float3 wo)
{
	float3 tmp = wi;
	wi = wo;
	wo = tmp;
	return abs(dot(wo,N) * dot(wi,Ng)) / max(1e-10,abs(dot(wo,Ng) * dot(wi,N)));
}


/***************************************************************************
	アイサブパス用
****************************************************************************/

//イメージセンサとレンズのサイズ
//static float AspectRatio = (float)Resolution.x / Resolution.y;
static float2 FilmSize = {0.3*AspectRatio, 0.3};	//縦24mmをMMD長さに変換したもの
static float FilmArea = FilmSize.x * FilmSize.y;
static float2 PixelOnFilmSize = FilmSize / Resolution;	//イメージセンサ上の1画素のサイズ[MMD/pix]
static float PixelOnFilmArea = PixelOnFilmSize.x * PixelOnFilmSize.y;
static float FilmDistance = CameraFoV * FilmSize.y / 2;	//レンズ→センサ間距離[MMD]
static float LensArea = PI*sqr(LensR);

//cameraPositionはどこか？... レンズの中心

//フィルム上の座標(カメラを手に持って構えて感光面を裏側から見た時の左上が0、右下が1)からビュー座標へ
float3 FilmToView(float2 f)
{
	return float3( (f - 0.5) * float2(FilmSize.x,-FilmSize.y), -FilmDistance);
}

void WritePixel(RWTexture2D<float4> rwtex, uint2 p, float4 c)
{
	uint2 b;
	rwtex.GetDimensions(b.x,b.y);
	if (all(p == clamp(p,0,b-1)))
		rwtex[p] += c;
}

//補間付書き込み…デノイズが効きづらくなるのでやめた
void WritePixelLerp(RWTexture2D<float4> rwtex, float2 pos, float4 c)
{
	if ( any(floor(pos)<0) || any(!isfinite(c)) )
		return;

	uint2 o = floor(pos);
	float2 f = pos-o;
	uint3 d = {1,1,0};

	WritePixel(rwtex, o        , c * (1-f.x) * (1-f.y));
	WritePixel(rwtex, o + d.xz , c * f.x * (1-f.y));
	WritePixel(rwtex, o + d.zy , c * (1-f.x) * f.y);
	WritePixel(rwtex, o + d.xy , c * f.x * f.y);
}


//pixのピクセル位置に輝度Ltを加算する
void AddFlarePix(int2 pix, float3 Lt, int waveCh)
{
	//はみだしちゃった
	if (any(pix!=clamp(pix,0,Resolution-1)))
		return;

	/* 分光 */
	if (SpectralRendering) {
		float3 xyz = mul(Lt,RGB2XYZ);
		xyz *= WaveMISWeight(waveCh);
		Lt = mul(xyz, XYZ2RGB);
	}

	//WritePixelLerp(FlareOutput, fp, float4(Lt,1));
	if (all(isfinite(Lt) == true))
		CurrentFrame[pix].xyz += Lt;
}

//AddFlareの正射影版
void AddFlareOrtho(inout Payload payload, float3 Lt, float3 P, float3 LensP, int waveCh)
{
	int2 pix;
	float4 p = mul(float4(P,1), ViewProjectionMatrix);
	p.y = -p.y;
	pix = (p.xy*0.5+0.5) * Resolution;

	AddFlarePix(pix, Lt, waveCh);
}

//t=1パス用、Pの位置から飛んでくるLtをレンズ上の点LensPを通してイメージセンサでキャッチ
void AddFlare(inout Payload payload, float3 Lt, float3 P, float3 LensP, int waveCh)
{
	if (!Perspective) {
		AddFlareOrtho(payload, Lt, P, LensP, waveCh);
		return;
	}
	
	float3x3 camMat = {CameraRight, CameraUp, CameraForward};

	//カメラ座標系にする
	LensP = mul(camMat, LensP-CameraPosition);
	P = mul(camMat, P-CameraPosition);

	//diffusion filterの分位置をずらす
	if (C_Diffusion) {
		float g = 1-C_Diffusion*0.001;
		float3 rdif = SampleHG(ComputeTBN(normalize(P)), RNG.xy, g);
		P = rdif * length(P);
	}

	if (P.z <= 0.01)
		return;

	int2 pix;	//書き込み位置
	float2 lens = LensR ? LensP.xy/LensR : 0;	//レンズの範囲を-1～1とするレンズ座標 → 錯乱円上の位置

	//cos項(We0に入れられなかった分)
	float cosT = abs(normalize(P-LensP).z);
	Lt *= cosT;	//5昼修正

	//A項…本来は画角の上げ下げに伴ってイメージセンサ1つ当たりに入ってくる光の量が減ったり増えたりするので
	//それを表すためにCameraPDFDirectionalRd()に入れるべき数値
	//現在の実装では画角やフィルム・レンズサイズを変えるとフィルム感度が自動的に補正されると捉えている
	//一方、これを入れないと画角を下げる(狭くする)ほどコースティクスが暗くなってしまうのでここで入れる
	Lt *= sqr(CameraFoV/PI);	//なんでかこのくらいの値にすると正射影の時と大体同じ明るさになるけど合ってるのか不明
	
	//アンチビネット
	Lt *= lerp(1, 1/sqr(sqr(cosT)), Devignette);

	//錯乱円のフィルム上でのサイズを求める
	//TODO:Apertureをサンプルする
	float m = FilmDistance / abs(length(P)-FilmDistance);	//像の拡大率
	float cocMMD = LensR * abs(Pint-length(P)) / Pint * m;	//錯乱円の半径[MMD]
	float2 coc = cocMMD / FilmSize.y * float2(lens.x,-lens.y);	//フィルムの大きさを1としてスケール
	float2 d = ViewToUV(P, CameraFoV, AspectRatio);	//Pのフィルム座標(左上が0、右下が1)
	float2 fp = (d+coc) * Resolution;
	pix = round(fp);	//Ltが格納されるピクセル

	AddFlarePix(pix,Lt,waveCh);
}


//カメラ側からz0→z1の方向rdをサンプルするpdf Pσ(z0→z1)
//測度は立体角
float CameraPDFDirectionalRd(Event z0, float3 rd)
{
	float cosT = dot(z0.TBN[2], rd);

	//z1はカメラの裏側である
	if (cosT < 0)
		return 0;

	//We(0)にresolution.x,yを掛ける方法だと寄与の計算中にアンダーフローを起こしがちなので
	//pdfを小さくするようにした
	//return sqr(FilmDistance) / ( PixelOnFilmArea * cosT * cosT * cosT);
	//return sqr(FilmDistance) / ( FilmArea * cosT * cosT * cosT);
	
	//↑を正直に実装すると全体的に暗くなるのでとりあえずcos^4乗則分だけ入れることにした
	//フィルムを大きくしたり画角を上げ下げした時や解像度を上げた時の画素当たりの光の量の変化を表現できるので
	//活かしたい気もする
	//導出については↓
	//https://pbr-book.org/3ed-2018/Light_Transport_III_Bidirectional_Methods/The_Path-Space_Measurement_Equation#SamplingCameras
	return 1 / (cosT * cosT * cosT);
}

//z0からz1をサンプルするpdf Pσ⊥(z0→z1)G(z0⇔z1), 測度は面積
float CameraPDFDirectional(Event z0, Event z1)
{
	//正射影の場合は距離によらず1
	if (!Perspective)
		return 1;

	float3 d = z1.P-z0.P;
	float3 rd = normalize(d);
	float p = CameraPDFDirectionalRd(z0, rd);
	float g = abs(dot(z1.TBN[2],rd)) / max(1e-10,dot(d,d));
	return p*g;
}

//SampleFirstとt=1パスのためのZ0サンプリング
//rdが不明な状態でレンズ上の一点をサンプリングする
//この時点ではrdが不明でcos項が分からないので、addFlareで後入れする
//t1path : t=1パスかどうか、falseならSampleFirst用, Ys1Pはt=1パスの時のY[s-1].P
Event SampleZ0(inout Payload payload, bool t1path = false, float3 Ys1P = 0)
{
	Event e = (Event)0;
	if (Perspective) {
		float2 Xi = RNG.xy;
		float2 lens = CosSin(Xi.x*2*PI) * sqrt(Xi.y);

		float2 auv = lens * 0.5 + 0.5;
		auv.y = 1-auv.y;
		float3 sibori = Aperture.SampleLevel(samp, auv, 0).xyz;

		e.P = CameraPosition + (lens.x*CameraRight + lens.y*CameraUp) * LensR;
		e.PG = LensArea ? 1/LensArea : 1;

		//本来↓はshibori / e.PGになる。レンズがデカくなれば入ってくる光の量が増えるという理屈
		e.beta = sibori;	//注意：cosθが入ってない
	} else {
		//t=1パス用の場合はe.PはY[s-1]に応じて決めなければならない
		float2 d;
		if (t1path) {
			//Y[s-1].PをカメラのX-Y平面に投影した位置(これは画面外かもしれないが、はみ出してる場合はAddFlareで弾かれる)
			float3 YC = Ys1P-CameraPosition;
			float t = dot(YC,CameraForward);
			e.P = Ys1P - t * CameraForward;
		} else {
			d = ((DispatchRaysIndex().xy + RNG.xy) / DispatchRaysDimensions().xy)*2-1;
			e.P = CameraPosition - CameraUp * d.y / ProjectionMatrix._22 + CameraRight * d.x / ProjectionMatrix._11;
		}
		e.PG = 1;
		e.beta = 1;
	}

	e.etaI = e.etaO = 1;
	e.TBN = float3x3(CameraRight, CameraUp, CameraForward);
	e.Ng = e.TBN[2];
	e.rusQ = 1;
	return e;
}

//最初のカメラ頂点をサンプルする
Event SampleFirstCamera(inout Payload payload, out float3 rd, out float fs1, out float pdf1, out float2 writePos)
{
	float3x3 camMat = {CameraRight, CameraUp, CameraForward};
	//薄レンズ近似モデルによる安直なDoF
	//SampleZ0でレンズ(開口)上の位置をサンプル -> rdの決定 -> cos項をbetaに追加する
	Event e = SampleZ0(payload);
	e.surface = true;
	fs1 = 1;

	if (Perspective) {
		writePos = DispatchRaysIndex().xy + RNG.xy;	//画素の書き込み位置[pix]
		float2 d = 1 - writePos / DispatchRaysDimensions().xy;	//画素に対応するフィルム座標(像が倒立するので反転する)
		float3 sensor = FilmToView(d);			//レイの出発点になるイメージセンサ上の位置(カメラ座標)
		float3 pinhall = -normalize(sensor);	//カメラ座標の原点にある仮想のピンホールを通って飛ぶレイ
		float3 fp = pinhall * Pint;				//ピントの合う位置(カメラ座標)
		rd = normalize(mul(fp,camMat) + CameraPosition - e.P);	//レンズ上のサンプル位置からfpを通るレイ(ワールド座標)
		float cosT = dot(rd,CameraForward);
		e.beta *= cosT;		//cos項を入れる(pdfと合わせてcos^4)
		pdf1 = CameraPDFDirectionalRd(e,rd);	//Pσ(z0→z1)
		
		//アンチビネット
		fs1 = lerp(1, 1/sqr(sqr(cosT)), Devignette);	//AddFlareの時には1で置き換わり、後でAddFlare内で再計算する
	} else {
		rd = CameraForward;
		pdf1 = 1;
	}

	//安いディフュージョンフィルタ(わりと本物)
	float g = 1 - C_Diffusion*0.001;
	float2 xi = RNG.xy;//	xi.y = step(xi.y,0.5)*0.5;
	float3 rdHG = SampleHG(ComputeTBN(rd), xi, g);
	float mu = dot(rdHG,rd);
	//e.beta = lerp(float3(0,0.1,1),1,smoothstep(0.999,0.9995,mu));
	//e.beta *= MieTable.SampleLevel(samp, saturate(float2(mu*0.5+0.5,C_DifRadius)) ,0);	//Mie解を適用
	//e.beta *= HSVtoRGB(float3(mu*100+0.2,mu<0.999,1));
	rd = rdHG;

	/* //確率を下げる代わりに前方散乱係数は割合現実的な例…びまん性に光が拡がる
	float P = 0.01 * C_Diffusion;	//実質の散乱確率
	float Q = min(0.9,P*50);		//ウェイトを下げる代わり上方修正した確率
	if (RNG.x < Q) {
		//ヒットした場合は確率が上がっている分ウェイトを下げる
		rd = SampleHG(ComputeTBN(rd), RNG.xy, 0.85);
		e.beta *= P/Q;	
	} else {
		//ミスヒットした場合は確率が下がっている分だけウェイトを上げる
		e.beta *= (1-P)/(1-Q);	
	}
	*/


	return e;
}

/***************************************************************************
	ライトサブパス作成用
****************************************************************************/
//ライトポリゴン/ボリューム・skyboxそれぞれを選択するpdf
static float LightSelectionPDF = IsLightFace() || TotalVolFlux ? 0.5 : 0;
static float SkyboxSelectionPDF = 1 - LightSelectionPDF;

//光源として発光ボリュームが選択される確率
float VolSelectionPDF()
{
	if (!IsLightFace())
		return 1;
	else {
		float v = TotalVolFlux;
		float l = MatLights[0].x/MatLights[0].y;
		return v/(l+v);
	}
}


//光源の発射点を選択するpdf[1/m2](ボリュームの場合は[1/m3])を返す
//iFace:ライトポリゴンの面番号、skyboxの場合0未満の値
//rd:skyboxの場合のサンプリングした方角。ライトポリゴンの場合は未使用
float lightPDFOrigin(Event e, float3 rd = 0)
{
	int id = e.iModel;
	int iFace = e.iFace;
	if (e.surface && iFace < 0) {
		//skyboxだった
		return SkyPDF(rd) * SkyboxSelectionPDF;
	} else if (e.surface) {
		if (!IsLightFace())
			return 0;
		
		int imat = PBR_idx[id] + Faces[id][iFace];
		if  (MatLights[imat].w > 0) {
			float area = FaceArea(id,iFace);
			return LightFacePdf(id,iFace)/max(1e-10,area) * LightSelectionPDF * (1-VolSelectionPDF());
		} else
			return 0;
	} else {
		//ボリュームである
		for (int i=0; i<nVolBox; i++) {
			//e.Pを含むボルボックスを探す
			float3 AA,BB;
			VolBoxAABB(i, AA,BB);
			if (all(e.P == clamp(e.P,AA,BB))) {
				//とりあえず最初の物を返すようにしているがこれでいいんだろうか？
				float3 R = BB-AA;
				return LightSelectionPDF * VolSelectionPDF() * VolFlux[i] / TotalVolFlux / (R.x*R.y*R.z);	//ボックス選択率/体積
			}
		}
		return 0;
	}
}

//光源の発射方向を選択するpdf[1/m2], ボリュームの場合[1/m3]を返す
//y0:光の発射点 y1:光の到達点
float lightPDFDirectioal(inout Payload payload, Event y0, Event y1)
{
	//そもそも発光体ではない(ボリュームの場合はy0自体の輝度が0でも周りが発光している可能性がある)
	if (all(y0.m.emission<1e-10) && y0.surface)
		return 0;
	
	//Y0→Y1に飛んでくるpdf
	float3 d = y1.P - y0.P;
	float3 wi = normalize(d);
	float NoL0 = y0.surface ? dot(wi,y0.TBN[2]) : 1;
	float NoL1 = y1.surface ? dot(wi,y1.TBN[2]) : 1;
	float pdf;

	//skyboxからの光の場合
	if (y0.sky)
		return abs(NoL1) / (PI*SceneRadius*SceneRadius);
	
	//まず、y0→y1の向きをサンプルするpdf
	if (y0.surface) {
		//ライトポリゴンの場合
		//前提:どの方向から見ても輝度が一定になるには面光源の場合は
		//     光源の法線に対する射出方向θについて放射強度I(θ)=cosθ/πに比例する
		if (abs(NoL0) < y0.m.lightCosFalloff)	//コーンの外
			return 0;
		else if (y0.m.twosided)	//twosidedの場合は全球に拡散
			pdf = 1 / (4*PI*(1-y0.m.lightCosFalloff));
		else if (NoL0>=0)	//そうでない場合、y0の法線方向の半球へ拡散
			pdf = 1 / (2*PI*(1-y0.m.lightCosFalloff));
		else
			return 0;		//照射されない方向から眺めている

	} else {
		pdf = 1/(4*PI);
	}

	//Pσ = Pσ⊥N・Lなので、pdf=Pσの中にNoL0は入ってる
	pdf *= abs(NoL1) / max(1e-10,dot(d,d));	//測度を立体角→面積に変換
	if (!y1.surface)
		pdf *= VolumeLengthPDF(payload, y0, y1);	//y1がボリュームの場合、y0からの距離でサンプルされる確率を掛ける

	return pdf;
}

//Lはy0→y1ベクトル(正規化済み)として、配光特性L1(y0→y1) = fs(y-1→y0→y1)を返す
//ボリューム非対応(ボリュームはVolLe1()を使う)
float lightLe1L(Event y0, float3 L)
{
	//skyboxの場合は均等拡散あつかい
	if (y0.sky)
		return 1/PI;

	//片面光源を裏側から見てる
	float NoL = dot(y0.TBN[2], L);
	if (!y0.m.twosided && NoL<0)
		return 0;
	
	//コーンの外側から見ている
	float cosT = abs(NoL);
	float ctF = y0.m.lightCosFalloff;
	if (cosT <= ctF)
		return 0;

	float ctH = max(y0.m.lightCosHotspot,ctF);	//θH < θF → cosH > cosFを必ず満たすようにする
	float delta = (ctH == ctF) ? 1 : saturate((cosT-ctF)/(ctH-ctF));
	//float Le1 = sqr(delta) * sqr(delta) / (2*PI*(1-(ctF+ctH)/2));
	float Le1 = sqr(delta) * sqr(delta) /  ( ((1-sqr(ctF)) + (1-sqr(ctH))) / 2 );

	if (y0.m.twosided)
		Le1 /= 2;

	return Le1/PI;
}

//発光面y0から受光面y1への配光特性Le1(y0→y1)
//ボリューム非対応(ボリュームはVolLe1()を使う)
float lightLe1(Event y0, Event y1)
{
	if (!y0.surface)
		return VolLe1();
	
	float3 L = normalize(y1.P-y0.P);
	return lightLe1L(y0, L);
}


//発光面y0の放射発散度を計算する
//ボリューム非対応(ボリュームはVolLe0(iVol,P)を使う)
float3 lightLe0(Event y0)
{
	//skyboxの場合は均等拡散光源扱い、Le0=π emission, Le1(ω)はωによらず1/π ... skyboxに対するcosθは常に1
	if (y0.sky)
		return y0.m.emission * PI;

	if (!y0.surface)
		return y0.m.emission * 4 * PI;
	
	//pbrtによればspoltlightの全放射束Φ ≒ I * 2π(1-(ctF+chH)/2) 但し、Iは減衰なしの場合の放射強度
	// I = Φ / 2π(1-(ctF+ctH)/2)
	// I(θ) = I * delta^4
	//
	// 面光源の場合 L(θ) = L cosθ f(θ) ... f(θ)はコーンによるθ毎の減衰係数、まずは θ<θF→1 else 0 と定義する
	// Le0 = ∫∫L f(θ) sinθcosθ dθdφ = 2πL ∫f(θ)sinθcosθ dθ, cosθ = μとおくと
	//      1                    1
	// 2πL ∫ f(μ) μ dμ = πL [μ^2]  = πL(1-μF^2)
	//      0                    μF

	//float3 Le0 = y0.m.emission * 2 * PI * (1 - (y0.m.lightCosFalloff+y0.m.lightCosHotspot)/2);
	float3 Le0 = y0.m.emission * PI * ((1-sqr(y0.m.lightCosFalloff)) + (1-sqr(y0.m.lightCosHotspot))) / 2;
	if (y0.m.twosided)
		Le0 *= 2;
	return Le0;
}

//ボリューム内の発光点をサンプルする
//iVol : 選択されたボルボックス
//pdf : みつかったサンプルの持つ体積当たりの確率密度
//P : 発光点の位置
//Le0 : 光束発散度
void SampleVolLight(inout Payload payload, out int iVol, out float pdf, out float3 P, out float3 Le0)
{
	//1.ボルボックスの選択
	//ボルボックスを全光束に比例した確率でサンプルする(ボルボックスはそんなに多くないので線形探索)
	pdf = 0;
	float cdf = 0;
	iVol = max(0,nVolBox-1);
	for (int i=0; i<nVolBox; i++) {
		pdf = VolFlux[i]/TotalVolFlux;
		cdf += pdf;
		if (RNG.x < cdf) {
			iVol = i;
			break;
		}
	}
	
	//2.ボルボックス内の点の選択、完全にランダムに1点
	//ミップマップを8分木として輝度に比例したサンプリングを試みたがシェーダが複雑になりすぎてハングアップしてしまうので諦めた
	float3 AA,BB,R;
	VolBoxAABB(iVol, AA,BB);
	R = BB-AA;
	pdf *= 1/(R.x*R.y*R.z);
	P = lerp(AA,BB,RNG.xyz);
	Le0 = VolLe0(iVol,P);
}


//光源側の最初の頂点y0を得て、ついでにy1の方向もサンプリングする
//入力 ro:カメラの位置(現状では何にも使われてない)
//出力 rd:y0→y1の方向, fs1:配光特性Le1(y0→y1), pdf1:rd選択時のPσ(y0→y1)
//返り値は頂点情報
Event SampleFirstLight(inout Payload payload, out float3 rd, out float fs1, out float pdf1)
{
	Event e = (Event)0;
	e.surface = true;
	e.etaI = e.etaO = 1;
	e.PGrev = 1;	//仮に1と入れとく。後で決定する
	e.rusQ = 1;

	float4 Xi = RNG;
	float3 L;
	//skyboxかライトか
	if (Xi.x < SkyboxSelectionPDF) {
		//skybox
		L = SampleSky(payload, 0, e.PG, e.m.emission, false);
		e.PG *= SkyboxSelectionPDF;	//Pσ(L)*選択確率のまま入れとく、後でPGFwdの計算などの際に工夫する(理由は↓)
		//本来↑は、1/面積なので1/∞になる
		//skybox上の点y0をサンプルする面積についてのpdfが必要になるのはMISウェイトを計算する時だけ
		//MISウェイトを計算する時は常に PA(y0) / PA(y1→y0) という比率として計算される
		//分母のPA(x0)はskyboxの半径をlとすると、Pσ(L)/l^2
		//lは非常に大きいのでPA(y1→y0) = (Pσ⊥(y1→y0)G(y1⇔y0)) = (Pσ⊥(y1→y0) cosθ1/l^2 ) , θ1はLとy1.ngのなす角
		//l^2同士でキャンセルされて PA(y0)/PA(y1→y0) = Pσ(L)/ (Pσ⊥(y1→y0)cosθ1) となる 

		e.TBN = ComputeTBN(-L);
		//e.P = L * SkyRadius;	//これだとskyboxからの光が原点に向かって全部降り注ぐ事に
		float3 target = SampleConcentricDisk(0, SceneRadius, e.TBN, RNG.xy, pdf1);	//シーン内のどこかに飛ぶ事にする
		e.P = target + L*SkyRadius;	//シーン内のどこかめがけて飛ばすことのできるskybox上の位置
		e.Ng = -L;
		e.sky = true;
		e.iModel = e.iFace = -1;
		e.m.lightCosFalloff = 0;
		e.m.lightCosHotspot = 0;
		rd = -L;
		fs1 = lightLe1L(e,L);
		e.beta = lightLe0(e) * abs(dot(e.TBN[2],rd)) / e.PG;	//Le0/PA(0)
	} else {
		//材質の全光束同士で按分した確率でボリューム/ライトのどっちを選択するか決める
		float volpdf = VolSelectionPDF();
		if (RNG.x < volpdf) {
			//発光ボリューム内の1点
			float pdf;
			float3 Le0;
			int iVol;
			SampleVolLight(payload, iVol, pdf, e.P, Le0);
			e.Ng = float3(0,0,1);	//てきとう(特に使われない)
			e.TBN = ComputeTBN(e.TBN[2]);
			e.PG = pdf * LightSelectionPDF * volpdf;	//pdf * 選択確率
			e.sky = false;
			e.surface = false;
			rd = SampleUniformSphere(RNG.xy);
			fs1 = VolLe1();
			pdf1 = VolLe1();
			e.m = (Material)0;
			e.iModel = iVol;	//y[1]のサンプルの時に使う
			e.iFace = -1;
			e.m.emission = Le0 * fs1;
			//実際にはy1をサンプルした時にβは決まる(ボリューム内での走行距離が決まらないと寄与は決まらないので)
			//s=0,1パスはコネクト時の寄与だけ得ることになる
			e.beta = 1 / e.PG;
		} else {
			//発光ポリゴン上の1点
			float4 XiA = RNG;
			float4 XiB = RNG;
			//y0についての情報
			int idL,ifL;	//ライトのモデル番号・面番号
			SampleLightIndex(RNG,idL,ifL);
			float area;
			e.P = SampleLightTriangle(idL, ifL, XiA.zw, area, e.TBN[2], e.m);
			e.TBN = ComputeTBN(e.TBN[2]);
			e.Ng = GeometryNormal(idL, ifL);
			e.PG = LightFacePdf(idL,ifL)/max(area,1e-10) * LightSelectionPDF * (1-volpdf);	//pdf = 選択率/面積
			e.sky = false;
			//以下、y0→y1について。配光特性Le1(y0→y1)と方向をサンプリングする際のpdf:Pσ(y0→y1)
			rd = SampleCone(e.TBN, XiB.xy, e.m.lightCosFalloff,  pdf1);
			//両面ライト
			if (e.m.twosided) {
				pdf1 /= 2;
				if (XiB.z < 0.5)
					rd = -rd;
			}
			e.iModel = idL;
			e.iFace = ifL;
			L = e.TBN[2];
			fs1 = lightLe1L(e,L);
			e.beta = lightLe0(e) * abs(dot(e.TBN[2],rd)) / e.PG;	//Le0/PA(0)
		}
	}

	return e;
}

//ガラスの消散係数を求める
float3 GlassMuT(Material m)
{
	return saturate(1-m.albedo) * m.cat.r;
}

/***************************************************************************
	サブパス作成共用
****************************************************************************/
//次のパッチを探す
//rd:eに入ってきたレイの向き
//e :元のパッチの位置
//ne:サンプルされる次のパッチ情報
//first : x0→x1の探索です、というフラグ
//fs1,pdf1:x1サンプル時のfs(=Le1(x0→x1))とpdf(Pσ(x0→x1))
//返り値 : 探索したパッチが終端だった場合はtrue
bool SampleNext(
	uniform int depth, inout Payload payload, inout float3 rd,
	inout Event e, out Event ne, float fs1, float pdf1,
	int waveCh, int sssCh, inout bool SSSPassed, inout int nVolscatter, bool adjoint)
{
	RayDesc ray;
	ray.Origin = e.P;
	ray.TMin = 1e-3;
	ray.TMax = 1e+5;
	ne = (Event)0;
	ne.rusQ = e.rusQ;
	BRDFOut B = (BRDFOut)0;

	[branch]
	if (depth == 0) {
		ne.etaI = e.etaO;
		ne.beta = fs1/pdf1 * e.beta;
		//最初の頂点x0からの探索では、rdの方向にレイを飛ばすだけ
		ray.Direction = rd;
	} else if (e.surface) {
		//表面での散乱・透過
		//2番目以降の頂点からの探索では、頂点eに入ってきたレイが、eによってどこに散乱するかをBRDFサンプリングによって決定する
		float3 Ng = e.Ng;
		float3x3 TBN = e.TBN;
		if (dot(rd,Ng)>0) {
			TBN = -TBN;
			Ng = -Ng;
		}
		SampleBRDF(payload, e.m, e.P, TBN, Ng, -rd, e.etaI, waveCh, sssCh, SSSPassed, B, false);
		if (B.SSS) {
			//表面下散乱パスの場合、eを出口パッチの状態に合わせる
			e.P = B.POut;
			e.TBN = ComputeTBN(B.NOut);
			e.Ng = B.NgOut;
			e.SSSOut = true;
			e.SSSIn = false;	//0124追加
			ne.beta = e.beta * B.beta * (adjoint ? CorrectShadingNormal(e.TBN[2], e.Ng, -rd,B.L) : 1);
			e.beta *= B.betaSSS;	//出口パッチ時点でのβにする(albedoとSSSによる色合いが加味された状態で、出る時のフレネル透過率を加味する前)
		} else {
			//BSDF/BRDFだけで評価できるパス
			if (B.BSSRDF) {
				//表面下散乱材料の入り口でフレネル反射した場合のパス
				e.SSSIn = true;
				e.SSSOut = false;	//0124追加
				if (e.m.roughness < 1e-3)
					e.S = true;
			}
			ne.beta = e.beta * B.beta * (adjoint ? CorrectShadingNormal(TBN[2], Ng, -rd,B.L) : 1);
		}
		e.etaO = B.IOR;
		ne.etaI = e.etaO;
		ray.Direction = B.L;
	} else {
		//ボリューム
		ray.Direction = SampleHG(e.TBN, RNG.xy, VolG);
		ne.beta = e.beta * e.m.albedo;	//σs
		ne.etaI = e.etaO = e.etaI;
	}

	//レイトレ
	ray.Origin = e.P;	//2025-0311、抜けていたので追加(SSSの出口パッチからのレイトレを行うようにする)
	TraceRay(TLAS,RAY_FLAG_NONE,0xFF, 0,1,0,ray,payload);

	//ボルボックス判定
	float3 volA, volB;	//ボルボックス内のどこからどこまでを動いたか
	float tV;	//ボルボックス内の走行距離
	bool volscatter = false;
	int iVol = -1;
	if (e.etaO == 1 && nVolscatter < MaxVolScatter) {
		//ガラスの中にはボルボックスの影響がない物とする
		float min_d = payload.miss ? SkyRadius : payload.t;
		float3 P1 = ray.Origin;
		float3 P2 = ray.Origin + min_d * ray.Direction;
		for (int i=0; i<nVolBox; i++) {
			float3 AA,BB;
			float t0,t1;
			VolBoxAABB(i, AA,BB);
			if (SegAABB(P1,P2, AA,BB, t0,t1)) {
				//ボルボックスと交差している
				//pdfは μt*exp(-μd)*HGで f = 透過率*散乱係数*BSDFはμs*exp(-μd)*HGなので ne.beta = e.beta * σs/σt(=albedo)でよい
				float d = SampleVolDist1(payload, i, P1+t0*ray.Direction,ray.Direction,t1-t0); //SampleFreePath(VolDens[i], RNG.x);
				float ht = d + t0;	//レイの始点→サンプルされた位置までの距離
				if (d < (t1-t0) && ht < min_d) {
					//ボリューム内で散乱を起した
					//↑かつ、レイの始点から見て一番手前でヒットしてるならヒット位置更新
					volscatter = true;
					min_d = ht;
					iVol = i;
				}
			}
		}
		ne.P = P1 + min_d * ray.Direction;	//volscatterがfalseでも後でセットされるので
	}

	//y0→y1が発光ボリューム内だった場合、βの値がここでやっと確定する
	if (depth == 0 && !e.surface) {
		//この時点でのe.betaは1/pdf (ボリューム内の走行で得られた寄与が1だった場合のスループット)
		float3 AA,BB;
		float t0,t1;
		VolBoxAABB(e.iModel, AA,BB);
		if (SegAABB(e.P,ne.P, AA,BB, t0,t1)) {
			ne.beta = e.beta * (t1-t0) * e.m.emission;
		} else {
			ne.beta = 0;
		}
	}


	bool toTheSky = payload.miss & (!volscatter);	//レイトレがミスってskyboxに行ったらトレース終了

	//次頂点のセットアップ
	if (volscatter) {
		//ボリュームに着いた
		nVolscatter++;
		ne.surface = false;
		ne.sky = false;
		ne.TBN = ComputeTBN(ray.Direction);	//ボリュームに本来法線は無いが次の飛び先のサンプリングの時に使うので作っとく
		ne.Ng = ray.Direction;
		//マテリアル
		ne.iFace = -1;
		ne.iModel = -1;
		ne.m.albedo = VolAlbedo(iVol);
		ne.m.emission = VolLe0(iVol, ne.P) * VolLe1();
	} else {
		//表面に着いた
		if (toTheSky) {
			//skyboxからの寄与を格納
			ne.m.emission = FetchSkybox(ray.Direction);
			ne.P = ray.Origin + ray.Direction * SkyRadius;
			ne.Ng = -ray.Direction;
			ne.TBN = ComputeTBN(ne.Ng);
			ne.sky = true;
			ne.iFace = -1;
			ne.iModel = -1;
			ne.surface = true;
		} else {
			//パッチの情報を格納
			ne.P = ray.Origin + ray.Direction * payload.t;
			GetPatch(payload.ID, payload.iFace, -ray.Direction, payload.uv, ne.m, ne.TBN);
			ne.Ng = GeometryNormal(payload.ID, payload.iFace);
			ne.S = (ne.m.roughness < 1e-3) && (ne.m.category==CAT_METAL || ne.m.category==CAT_GLASS);
			ne.iFace = payload.iFace;
			ne.iModel = payload.ID;
			ne.surface = true;
		}

		//muTの設定
		if (e.etaO == 1) //e→neの間は空気
			ne.muT = 0;	
		else if (e.etaI == 1) //eでガラスの中に入った
			ne.muT = GlassMuT(e.m);
		else
			ne.muT = e.muT;
		//透過率
		if (!ne.sky)
			ne.beta *= exp(-ne.muT*length(ray.Origin-ne.P));

		//ボリュームの透過率は散乱イベントとして勘定しているので(多分)必要ない
	}

	//ロシアン
	float botsu = false;
	if (depth > 3) {
		float q = min(1,RGBtoY(B.beta));	//パスの継続確率
		if (q > RNG.x) {
			ne.beta /= q;
			ne.rusQ = e.rusQ * q;
		} else {
			botsu = true;
			ne.rusQ = e.rusQ * (1-q);
		}
	}

	rd = ray.Direction;
	return toTheSky || all(ne.beta<1e-10) || botsu;
}


//BxDFの評価
//ei→e→eoへの反射率
//waveCh : サンプリングしている波長
//NoL抜き、F入り
float3 BxDF(Event ei, Event e, Event eo, int waveCh, uniform bool adjoint)
{
	float3 wi = normalize(ei.P - e.P);
	float3 wo = normalize(eo.P - e.P);
	if (e.surface) {
		float3x3 TBN = e.TBN;
		float3 Ng = e.Ng;
		Material m = e.m;
		float etaO = MaterialIOR(e.m,waveCh,e.etaI);
		float etaI = e.etaI;

		//入射レイを基準に面の法線の向きを合わせる
		if (dot(wi,Ng) < 0) {
			TBN = -TBN;
			Ng = -Ng;
		}

		//BRDFではなくBTDFで評価してねフラグ
		bool needBTDF = sign(dot(wi,Ng)) != sign(dot(wo,Ng));

		//ガラス以外で透過が必要な場合は0で返る
		if (m.category!=CAT_GLASS && needBTDF) {
			return 0;
		}

		float3 H = normalize(wi+wo);
		float u = FresnelSchlick(abs(dot(wi, H)));
		float3 F = lerp(m.category==CAT_METAL ? m.albedo : IORtoF0(etaO/etaI),1,u);
		float2 a = m.ggxA;

		float3 diffuse, specular;

		if (needBTDF)
			return GGXAnisoBTDF(a, wi,wo,TBN, etaI, etaO) * (1-F);

		if (e.SSSOut) {
			//SSSの出口パッチの場合、フレネル透過分(1-F)だけが寄与になる
			//albedo分とSSSによる吸収分は既にβに入ってる
			//出口のフレネル透過率はe.βには入ってない(ne.βには反映されている)
			diffuse = saturate(1-F)/PI;	//出口パッチからの拡散反射分
			specular = 0;
		} else if (e.SSSIn) {
			//SSSの入口パッチの場合、鏡面反射だけが寄与になる
			diffuse = 0;
			specular = F * GGXAnisoBRDF(a, wi,wo, TBN);
		} else {
			diffuse = m.category==CAT_METAL ? 0 : saturate(1-F)*m.albedo/PI;
			float3 F0ms = m.category==CAT_METAL ? m.albedo : 1;
			specular = F * GGXAnisoBRDF(a, wi,wo, TBN);
		}

		return (diffuse + specular) * (adjoint ? CorrectShadingNormal(TBN[2],Ng, wi,wo) : 1);
	} else {
		//ボリュームによる散乱(HG * σs)
		return HenyeyGreenstein(-dot(wi,wo), VolG) * e.m.albedo;
	}
}

//全ボルボックスによるy-z間の透過率と寄与(コネクト用)
float3 VolumeTransmittance(Payload payload, Event y, Event z)
{
	float tr = 1;
	for (int i=0; i<nVolBox; i++) {
		tr *= VolTr1(payload, i, y.P,z.P);
	}
	return tr;
}

//全ボルボックスから得られる発光分による寄与をサンプルする
float3 VolumeEmission(Payload payload, Event y, Event z)
{
	float3 Le = 0;
	for (int i=0; i<nVolBox; i++) {
		Le += SampleVolEmission(payload, i, y.P,z.P);
	}
	return Le;
}

//y,z間のガラスによる透過率を計算する(間に何も挟まっていない事が前提)
float3 GlassTransmittance(Event yp, Event y, Event z, Event zp, out bool inGlass)
{
	inGlass = false;
	if (y.sky || z.sky)
		return 1;

	float3 muY = y.muT;
	float3 muZ = z.muT;
	float3 ry = normalize(y.P-yp.P);
	float3 rz = normalize(z.P-zp.P);
	float3 yz = normalize(z.P-y.P);
	float3 zy = -yz;

	//ガラスの表面をまたいでる？
	if (y.m.category == CAT_GLASS) {
		if (dot(ry,yz) > 0) {
			if (y.etaI == 1) {
				muY = GlassMuT(y.m);
				inGlass = true;
			} else
				muY = 0;
		}
	}

	if (z.m.category == CAT_GLASS) {
		if (dot(rz,zy) > 0) {
			if (z.etaI == 1) {
				muZ = GlassMuT(z.m);
				inGlass = true;
			} else
				muZ = 0;
		}
	}
	float3 muT = (muY+muZ)/2;
	return exp(-muT*length(y.P-z.P));
}


/***************************************************************************
	RayGeneration
****************************************************************************/
[shader("raygeneration")]
void RayGeneration()
{
	Payload payload = (Payload)0;

	//パスの最初から終わりまで変わらない情報のセットアップ
	float3x3 camMat = {CameraRight, CameraUp, CameraForward};
	int waveCh = SampleWaveChannel(RNG.xy); //波長
	int sssCh = floor(RNG.x*3);	//SSS用のRGB波長

	Event Z[MAX_DEPTH];
	Event Y[MAX_DEPTH];
	int nL = 1 ,nE = 1;
	bool sssPassed;	//BSSRDFサンプル用フラグ

	//アイサブパス作成
	float3 rdE;
	float fs1E,pdf1E;
	float2 writePos;	//ピクセル書き込み位置(アンチエイリアス入り書き込み用だがデノイザが効かなくなるので現在は特に使ってない)
	Z[0] = SampleFirstCamera(payload, rdE, fs1E, pdf1E, writePos);
	sssPassed = false;
	int nVolscatter = 0;
	for (int i=0; i<MaxBounce-1; i++) {
		nE++;
		if (SampleNext(i, payload, rdE, Z[i], Z[i+1], fs1E, pdf1E, waveCh, sssCh, sssPassed, nVolscatter, false))
			break;
	}

	//ライトサブパス作成
	float3 rdL;
	float fs1L,pdf1L;
	Y[0] = SampleFirstLight(payload, rdL,fs1L,pdf1L);
	nVolscatter = 0;
	//sssPassed = false;
	for (int i=0; i<MaxBounce-1; i++){
		nL++;
		if (SampleNext(i, payload, rdL, Y[i], Y[i+1], fs1L, pdf1L, waveCh, sssCh, sssPassed, nVolscatter, true))
			break;
	}


	//PG,PGrevの計算
	//X[0]のPGは各々の面積or体積pdfが入ってる
	for (int i=2; i<=nE-1; i++) {
		Z[i].PG = PG(payload,waveCh, Z[i-2], Z[i-1], Z[i], true);
		Z[i-2].PGrev = PG(payload,waveCh, Z[i], Z[i-1], Z[i-2], false);
	}
	for (int i=2; i<=nL-1; i++) {
		Y[i].PG = PG(payload,waveCh, Y[i-2], Y[i-1], Y[i], true);
		Y[i-2].PGrev = PG(payload,waveCh, Y[i], Y[i-1], Y[i-2], false);
	}
	//pdf1Xの測度は立体角なので、面積or体積に直す
	Z[1].PG = ConvertPDF(pdf1E, Z[0],Z[1]);
	Y[1].PG = ConvertPDF(pdf1L, Y[0],Y[1]);
	//この時点で不定なのは X[nX-1].PGrev, X[nX-2].PGrev これらはコネクト時に確定する

	//ライトサブパスの終端がミスってskybox方面に行った場合は接続できないので消しとく
	//アイサブパスの場合はskyboxからの寄与はs=0で得られるのでアイサブパス側にこの処理はない
	//この処理によってY[0]以外は sky=falseになる事が保証される
	if (Y[nL-1].sky)
		nL--;
	
	//s==1の時用, パスの長さk別にY0'を作っとく…キャッシュの効きが悪くなるのか凄く遅くなる割に収束は良くならないのでやめた
	//ていうかなんか間違っている気がする, ループの内側でy0dを都度サンプルするのが正しいような
	/*
	Event Y0d[MAX_DEPTH];
	float fs1Ld[MAX_DEPTH];
	float Y1fwd[MAX_DEPTH];
	float Y2fwd[MAX_DEPTH];
	for (int i=2; i<MAX_DEPTH; i++) {	//s=1,t=1以上でないと使われないのでk≧2
		float pdf1,__;	float3 ___;
		Y0d[i] = SampleFirstLight(payload, ro, ___, fs1Ld[i], pdf1);
		Y0d[i].PG = lightPDFDirectioal(Y0d[i],Y[1]);
		Y0d[i].PGrev = PGRev(waveCh, Y0d[i], Y[1], Y[2]);
		Y1fwd[i] = pdf1;
		Y2fwd[i] = PGFwd(waveCh, Y0d[i],Y[1],Y[2]);
	}
	for (int i=0; i<2; i++) {	//k=1の場合用→s=1,t=1なので今の所使われない
		Y0d[i] = Y[0];	//PGrevは計算済み
		fs1Ld[i] = fs1L;
		Y1fwd[i] = Y[1].PG;
		Y2fwd[i] = Y[2].PG;
	}
	*/

	//t=1パスの時はZ[0]をサンプルしなおすので、本来のZ[0]を保持しとく
	Event Z0original = Z[0];

	//Cs,tの評価
	float3 Lt = 0;
	for (int s=0; s<=nL; s++) {
		//t=0のパスについては一旦考えない事にする
		for (int t=1; t<=nE; t++) {
			int k = s+t-1;
			bool skipCalcWeight = false;	//ウェイトの計算抜きで100%寄与を得て良いよフラグ
			Z[0] = Z0original;
			/*
			Y[0] = Y0d[k];	//パスの長さ別にY0は違う所を参照する
			fs1L = fs1Ld[k];
			Y[1].PG = Y1fwd[k];
			Y[2].PG = Y2fwd[k];
			*/

			//辺が無い、または辺が多すぎる場合はノーカン
			if (k<1 || k >= MaxBounce)
				continue;

			//アイサブパスの終端がskyboxに飛んで行ってる場合、ライトサブパスとは繋げない
			//ただし、s==0の場合はアイサブパスがskyboxと直接つながってるので寄与を得られる
			if (t>1)
				if (s!=0 && Z[t-1].sky)
					continue;
			
			//視点と光源が1点ずつのケースは、t=2, s=0に100%ウェイトを与えることで計算するので弾く
			//レンズフレアとかを計算したい場合はこのパスも考慮した方がいい？
			if (t==1 && s==1)
				continue;

			//t=1パスの場合、カメラ上の点をサンプルする
			if (t==1)
				Z[0] = SampleZ0(payload, true, Y[s-1].P);
			
			float3 C;	//ウェイト無し寄与C*s,t
			if (s==0) {
				if (Z[t-1].surface) {
					//アイサブパスが光源 or skybox直撃の場合は寄与を得る
					C = lightLe0(Z[t-1]) * lightLe1(Z[t-1],Z[t-2]) * Z[t-1].beta;
					//裏面から片面ポリゴンを見ていたりコーンの外側だったりして寄与0の場合
					if (all(C < 1e-10))
						continue;
				} else {
					//発光ボリューム
					//TODO : s==1の時も寄与に変更する処理が必要だと思う(s=0→s=2間の走行距離で寄与を決めていたので)
					C = VolumeEmission(payload, Z[t-1],Z[t-2]) * Z[t-1].beta;
				}
			} else {
				//ここを通るパスは↓の条件を満たしている
				//s≧1, t≧1, Z[t-1].sky = false

				//端点が片方でもS頂点(BSDFがδ関数)だったらつなげない
				if (Y[s-1].S || Z[t-1].S)
					continue;

				//コネクト！
				float3 fyz,fzy;	//fs(ys-2→ys-1→zt-1), fs(ys-1→zt-1→zt-2)
				float gyz;

				//ライト→カメラ反射率
				if (s==1)
					fyz = lightLe1(Y[s-1],Z[t-1]);
				else {
					fyz = BxDF(Y[s-2], Y[s-1], Z[t-1] ,waveCh, true);
					//fyz = BxDF(Z[t-1], Y[s-1], Y[s-2] ,waveCh, true);
				}

				//カメラ→ライト反射率
				if (t==1)
					fzy = 1; //addFlareで後入れする	//fs1E;
				else {
					//fzy = BxDF(Y[s-1], Z[t-1], Z[t-2] ,waveCh, false);
					fzy = BxDF(Z[t-2], Z[t-1], Y[s-1] ,waveCh, false);	//5昼修正、視点側がwiになるようにした
				}
				
				//幾何項
				gyz = //GeometryTerm(Y[s-1].P,Z[t-1].P, Y[s-1].TBN[2], Z[t-1].TBN[2], !Y[s-1].sky,true, Y[0].sky);
					GeometryTerm(Y[s-1].P, Z[t-1].P, Y[s-1].TBN[2], Z[t-1].TBN[2],
								(!Y[s-1].sky) && Y[s-1].surface, Z[t-1].surface, Y[s-1].sky);
				
				//透過率(カメラと光源は常にガラスの中には無いと仮定している)
				float3 tr = 1;
				float3 vle = 0;	//ボリュームによる寄与
				bool inGlass = false;	//Y[s-1]とZ[t-1]はガラスの内部か？
				if (s>1 && t>1)
					tr = GlassTransmittance(Y[s-2],Y[s-1],Z[t-1],Z[t-2], inGlass);
				if (!inGlass) {
					tr *= VolumeTransmittance(payload, Y[s-1],Z[t-1]);
					vle = VolumeEmission(payload, Y[s-1],Z[t-1]);
				}
				
				//発光ボリュームがない(散乱・吸収ボリュームのみ)場合
				//float3 cst = fyz * gyz * fzy * tr;	//コネクト係数(まだ可視項抜き)
				//C = Y[s-1].beta * cst * Z[t-1].beta;
				
				//発光ボリューム込み
				C = (Y[s-1].beta * fyz * gyz * tr + vle) * fzy * Z[t-1].beta;
				
				//TODO : コネクトが失敗してもボリュームによって寄与が得られるケースはないか？
				if (any(C))	//ここまででほぼ0になってたらレイトレしないで「寄与なし」とす
					C *= VisibilityTerm(payload, Y[s-1],Z[t-1], s==1);	//レイトレ可視項

				//SSSで接続できる場合 ほぼ起こらないので考えなくてもいいっぽい
				/*
				if (Y[s-1].SSSOut && Z[t-1].SSSOut) {
					if (Y[s-1].iModel == Z[t-1].iModel) {
						Material m = Z[t-1].m;
						float3 mfp = m.cat.xyz * m.cat.w * 100;
						float3 S = SSSScale(m.albedo, mfp);
						float3 Rr = SSSPDF(max(length(Y[s-1].P - Z[t-1].P),1e-3),S);
						C += Y[s-1].beta * Rr * Z[t-1].beta;	//本当はSSSの入口座標同士で接続して入口時点でのbetaの方がいい?
					}
				}
				*/
			}

			if (all(C == 0))
				continue;

			//ウェイトの計算
			float wst;
			if (skipCalcWeight) {
				wst = 1;
			} else if (s+t == 2) {
				//ここを通るのはs=0,t=2のみ
				wst = 1;
			} else {
				//この時点で不定なのは X[nX-1].PG, X[nX-1].PGrev, X[nX-2].PGrev
				float p = 1;		//p(s)=1としてpdfの相対的な値を以下のループによって足していく
				float p_sum = 1;	//pの合計。p(s)=1を最初に足しとく
				
				//ライトサブパス方向へ探る(s,tのs--,t++方向)
				for (int i=s-1; i>=0; i--) {
					//iとは何かというと、「もしY[s-1]とZ[t-1]でなく、Y[i]とY[i-1]の位置で接続されていたら？」という仮想接続エッジ
					//もし全パスのMISウェイトを1としたら、頂点が全く同じパス同士で、重複して寄与が得られてしまう
					//重複したパスには面積積測度あたりの確率密度p(i)の比に応じてウェイトを計算し、寄与に対する割合を算出する
					//Y[i]とY[i-1]では互いに可視である事は自明なので「仮想接続」に可視判定は必要ない
					float f = Y[i].PG;
					float r = Y[i].PGrev;

					//ここに来る時点でs≧1,t≧1,かつs+t≧3は保証されている
					//接続エッジに近傍の頂点のPGRevの再計算
					//fは元々計算してある値でOK
					if (i==s-1) {
						if (t==1)
							r = CameraPDFDirectional(Z[t-1],Y[s-1]);
						else
							r = PG(payload,waveCh, Z[t-2],Z[t-1],Y[s-1], false);
					} else if (i==s-2) {
						r = PG(payload,waveCh, Z[t-1],Y[s-1],Y[s-2], false);
					}

					//S頂点で反射した結果のPG,PGrevは0で記録してあるのでここで1に変換する
					//pの計算上S頂点は無かった扱いになる
					p *= Remap0(r)/Remap0(f);

					//S頂点、またはPGがS頂点由来ならp_sumに足さない(単純にスキップする)
					if (Y[i].S || ((i>0) && Y[i-1].S))
						continue;
					
					p_sum += p;
				}

				//アイサブパス方向へ(s,tのs++,t--方向)
				//s==0パスの時はZ[t-1]が光源上の点という事になる
				p = 1;
				for (int i=t-1; i>=1; i--) {

					float f = Z[i].PG;
					float r = Z[i].PGrev;

					if (i==t-1) {
						float3 L = normalize(Z[t-1].P - Z[t-2].P);	//skyboxをサンプルする方向
						if (s==0) {
							r = lightPDFOrigin(Z[t-1], L);	//skyboxの場合はiFaceに-1が入っている, 1029昼修正、iModelを付けた
						} else if (s==1) {
							r = lightPDFDirectioal(payload, Y[0],Z[t-1]);
						} else
							r = PG(payload,waveCh, Y[s-2],Y[s-1],Z[t-1], false);
					} else if (i==t-2) {
						r = (s>0) ? PG(payload,waveCh, Y[s-1],Z[t-1],Z[t-2], false) : lightPDFDirectioal(payload, Z[t-1],Z[t-2]);
					}

					p *= Remap0(r)/Remap0(f);

					if (Z[i].S || Z[i-1].S)
						continue;

					p_sum += p;
				}
				wst = 1/p_sum;
			}
			float3 Cst = wst * C;

			//チェック用をここに
			/*
			int2 filterIdx = floor(8 * DispatchRaysIndex().xy / DispatchRaysDimensions().xy);
			if (s==filterIdx.x && t==filterIdx.y)	//左上隅：s=0,t=0 右:s++ 下:t++
				Cst = C;
			else
				Cst = 0; */

			if (t==1) {
				if (all(isfinite(Cst))) {
					float3 tr = VolumeTransmittance(payload, Y[s-1],Z[0]);
					AddFlare(payload, min(tr * Cst * Exposure, CLAMP_L), Y[s-1].P, Z[0].P, waveCh);	
				}
			} else
				Lt += max(0, Cst);
		}
	}

	//NaN,Infチェック
	if (any(!isfinite(Lt)))
		return;

	if (SpectralRendering) {
		float3 xyz = mul(Lt,RGB2XYZ);
		xyz *= WaveMISWeight(waveCh);
		Lt = mul(xyz, XYZ2RGB);
	}

	//露出補正などをやって結果発表
	float3 result = Lt * Exposure;
	result = clamp(result, -CLAMP_L,CLAMP_L);	//bias入りfirefly対策

	//マイナスの値もそのままアキュムレーションする(そうしないと分光の結果が赤っぽくなる)
	//WritePixelLerp(RTOutput, writePos, float4(result,1));
	bool primarySky = (nE==2) && (Z[1].sky);	//プライマリヒットがskyboxだった
	float backAlpha = 1;
	if (primarySky)
		backAlpha = 0;
	CurrentFrame[DispatchRaysIndex().xy] += float4(result, backAlpha);

	//このパスでRTOutputにアキュムレーションまでやるのは不可
	//t=1パスでランダムな位置への書き込みが入るので、全ピクセルの計算が終わらないと1フレームの計算は完了しない
}
#endif